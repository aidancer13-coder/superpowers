{"nodes": [{"id": "docs_superpowers_specs_2026_05_05_platform_neutral_prose_design", "label": "Platform-neutral prose \u2014 Phase A design spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-05-05-platform-neutral-prose-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_05_05_platform_neutral_prose_design_phase_a", "label": "Phase A: neutralize generic Claude prose in skills and README", "file_type": "concept", "rationale": "Avoids the mistake of openai/plugins#217's wholesale rewrite (which altered historical attribution, model names, and install instructions); only genuinely incidental platform-centric prose is removed, in phase-sliced atomic commits with carve-outs for model names, filenames/URLs, and the Claude Code runtime name.", "source_file": "docs/superpowers/specs/2026-05-05-platform-neutral-prose-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_05_05_platform_neutral_prose_design_cso_sdo_rename", "label": "Coined-term rename: Claude Search Optimization (CSO) \u2192 Skill Discovery Optimization (SDO)", "file_type": "concept", "rationale": "The coined term embedded a platform name in a concept that applies to any agent runtime; renaming the heading, acronym, and in-file cross-references in skills/writing-skills/SKILL.md is done first as its own mechanical, easily revertable commit.", "source_file": "docs/superpowers/specs/2026-05-05-platform-neutral-prose-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_05_05_platform_neutral_prose_design_replacement_style", "label": "Replacement style: second/third-person agent phrasing", "file_type": "concept", "rationale": "A mix of 'your agent' (addressing the skill author) and 'the agent/agents' (generic system behavior) reads naturally in English; consistency is not forced at the cost of awkward phrasing, and pluralization is preferred when natural.", "source_file": "docs/superpowers/specs/2026-05-05-platform-neutral-prose-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_specs_2026_05_05_platform_neutral_prose_design", "target": "docs_superpowers_specs_2026_05_05_platform_neutral_prose_design_phase_a", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-05-05-platform-neutral-prose-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_05_05_platform_neutral_prose_design", "target": "docs_superpowers_specs_2026_05_05_platform_neutral_prose_design_cso_sdo_rename", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-05-05-platform-neutral-prose-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_05_05_platform_neutral_prose_design", "target": "docs_superpowers_specs_2026_05_05_platform_neutral_prose_design_replacement_style", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-05-05-platform-neutral-prose-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_05_05_platform_neutral_prose_design", "target": "skills_writing_skills_skill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-05-05-platform-neutral-prose-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_05_05_platform_neutral_prose_design", "target": "skills_writing_skills_anthropic_best_practices", "relation": "references", "confidence": "EXTRACTED", "conf