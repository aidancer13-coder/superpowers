{"nodes": [{"id": "skills_writing_skills_testing_skills_with_subagents", "label": "Testing Skills With Subagents", "file_type": "document", "source_file": "skills/writing-skills/testing-skills-with-subagents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_writing_skills_testing_skills_with_subagents_tdd_mapping", "label": "TDD Mapping for Skill Testing (RED-GREEN-REFACTOR)", "file_type": "concept", "source_file": "skills/writing-skills/testing-skills-with-subagents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skill creation is just TDD applied to process documentation: run scenarios without the skill (RED - watch it fail), write a skill addressing those specific failures (GREEN), then close loopholes (REFACTOR). If you never watched an agent fail without the skill, you don't know if the skill prevents the right failures."}, {"id": "skills_writing_skills_testing_skills_with_subagents_pressure_scenarios", "label": "Pressure Scenarios for Skill Testing", "file_type": "concept", "source_file": "skills/writing-skills/testing-skills-with-subagents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Combine 3+ pressures (time, sunk cost, authority, economic, exhaustion, social, pragmatic) with concrete A/B/C options so the agent WANTS to violate the rule - agents resist a single pressure but break under multiple, and only then do you learn what the skill must prevent."}, {"id": "skills_writing_skills_testing_skills_with_subagents_rationalization_table", "label": "Rationalization Table", "file_type": "concept", "source_file": "skills/writing-skills/testing-skills-with-subagents.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Capture every agent excuse verbatim and plug each hole with an explicit negation in the rule plus a table entry and red-flag entry, because generic counters (\"don't cheat\") don't work - each specific rationalization needs a specific counter."}], "edges": [{"source": "skills_writing_skills_testing_skills_with_subagents", "target": "skills_writing_skills_testing_skills_with_subagents_tdd_mapping", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/writing-skills/testing-skills-with-subagents.md", "source_location": null, "weight": 1.0}, {"source": "skills_writing_skills_testing_skills_with_subagents", "target": "skills_writing_skills_testing_skills_with_subagents_pressure_scenarios", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/writing-skills/testing-skills-with-subagents.md", "source_location": null, "weight": 1.0}, {"source": "skills_writing_skills_testing_skills_with_subagents", "target": "skills_writing_skills_testing_skills_with_subagents_rationalization_table", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/writing-skills/testing-skills-with-subagents.md", "source_location": null, "weight": 1.0}, {"source": "skills_writing_skills_testing_skills_with_subagents", "target": "skills_writing_skills_examples_claude_md_testing", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/writing-skills/testing-skills-with-subagents.md", "source_location": null, "weight": 1.0}, {"source": "skills_writing_skills_testing_skills_with_subagents_pressure_scenarios", "target": "skills_writing_skills_persuasion_principles", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/writing-skills/testing-skills-with-subagents.md", "source_location": null, "weight": 1.0}, {"source": "skills_writing_skills_testing_skills_with_subagents_pressure_scenarios", "target": "skills_writing_skills_persua