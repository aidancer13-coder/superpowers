-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_04_06_worktree_rototill_design", "target": "skills_subagent_driven_development_skill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-04-06-worktree-rototill-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_04_06_worktree_rototill_design", "target": "skills_executing_plans_skill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-04-06-worktree-rototill-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_04_06_worktree_rototill_design", "target": "skills_writing_plans_skill", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-04-06-worktree-rototill-design.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "worktree_rototill_detect_and_defer_design", "label": "Worktree Rototill detect-and-defer design", "nodes": ["docs_superpowers_specs_2026_04_06_worktree_rototill_design", "docs_superpowers_specs_2026_04_06_worktree_rototill_design_detect_and_defer", "docs_superpowers_specs_2026_04_06_worktree_rototill_design_step_1a_native_tools", "docs_superpowers_specs_2026_04_06_worktree_rototill_design_step_1b_git_fallback"], "relation": "form", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-04-06-worktree-rototill-design.md"}]}