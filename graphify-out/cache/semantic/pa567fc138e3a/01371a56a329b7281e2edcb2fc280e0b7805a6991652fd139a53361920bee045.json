{"nodes": [{"id": "docs_superpowers_plans_2026_06_09_visual_companion_issues", "label": "Visual Brainstorming Companion \u2014 Issue & Change Catalog", "file_type": "document", "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_brainstorming_scripts_server_cjs", "label": "server.cjs \u2014 zero-dep HTTP + WebSocket server (RFC 6455 hand-rolled)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_brainstorming_scripts_helper_js", "label": "helper.js \u2014 injected page script (WebSocket client, click capture, window.brainstorm API)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_brainstorming_scripts_frame_template_html", "label": "frame-template.html \u2014 frame (header, theme CSS, status dot) around content fragments", "file_type": "code", "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_brainstorming_scripts_start_server_sh", "label": "start-server.sh \u2014 launch wrapper (session dir, host/url, owner-PID, backgrounding)", "file_type": "code", "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_brainstorming_scripts_stop_server_sh", "label": "stop-server.sh \u2014 kills server by PID file, cleans /tmp sessions", "file_type": "code", "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_brainstorming_visual_companion_md", "label": "visual-companion.md \u2014 operator guide the agent reads when it accepts the companion", "file_type": "document", "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_brainstorming_skill_md", "label": "SKILL.md \u2014 where the companion is offered and the per-question decision lives", "file_type": "document", "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_visual_companion_issues_issue_category_security", "label": "Category A \u2014 server security hardening (server.cjs)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_visual_companion_issues_issue_category_robustness", "label": "Category B \u2014 server robustness / correctness", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_visual_companion_issues_issue_category_lifecycle", "label": "Category C \u2014 lifecycle / timeout (issue #1237)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_visual_companion_issues_issue_category_features", "label": "Category D \u2014 features", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_visual_companion_issues_issue_category_workshop_deferred", "label": "Category E \u2014 workshop / deferred / dropped", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_visual_companion_issues_a1_per_session_secret_key", "label": "A1 \u2014 per-session secret key on /, /files/*, and WS (chosen approach; supersedes Host allowlist)", "file_type": "concept", "rationale": "A per-session secret key is the only mechanism that authenticates a client uniformly across loopback, SSH tunnel, and direct-remote, and also defeats DNS rebinding; a Host allowlist only defends the loopback browser confused-deputy and is theater for remote exposure, where a direct client just sends the expected Host.", "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_visual_companion_issues_a2_host_allowlist_dropped", "label": "A2 \u2014 Host allowlist dropped; browser WS Origin check retained after auth", "file_type": "concept", "rationale": "Subsumed by A1: the secret key closes the WS-injection vector (#1014), the DNS-rebinding read vector (PR #1553), and the cross-origin WS vector (PR #1110) in one mechanism, and unlike an allowlist it actually protects the remote-bind case.", "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_visual_companion_issues_a3_null_ws_payload_crash", "label": "A3 \u2014 server crashes on null / non-object WS payload", "file_type": "concept", "rationale": "JSON.parse can't produce undefined and primitives return undefined for .choice without throwing, so only null is the live hazard (null.choice throws); a minimal exact guard is preferred over a top-level try/catch or uncaughtException handler because those would mask other bugs.", "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_visual_companion_issues_a4_frame_length_bound", "label": "A4 \u2014 frame-length bound in decodeFrame (already fixed; verify/close #1446)", "file_type": "concept", "rationale": "MAX_FRAME_PAYLOAD_BYTES = 10MB is already enforced before any Buffer.alloc, so the action is to verify #1446 against current dev and close it rather than re-implementing.", "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_visual_companion_issues_b1_dotfile_screens", "label": "B1 \u2014 macOS resource-fork dotfiles (._*.html) served as screen content", "file_type": "concept", "rationale": "The newest-screen selector filters only on endsWith('.html'), so on macOS/ExFAT resource-fork files pass the filter and, being written alongside the real file, can sort newest \u2014 the browser gets binary metadata instead of the mockup.", "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_visual_companion_issues_b2_stale_pid_kill", "label": "B2 \u2014 stop-server.sh can kill a reused/stale PID", "file_type": "concept", "rationale": "After a reboot or PID wraparound the state/server.pid file can point at an unrelated process, which would then be SIGKILLed; ownership must be verified (node running server.cjs) and the script should fail closed with stale_pid if it can't be proven.", "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_visual_companion_issues_b3_ws_reconnect_backoff", "label": "B3 \u2014 WS client silent reconnect and stale 'Connected' status", "file_type": "concept", "rationale": "A fixed 1s reconnect timer with no onerror handler and a hardcoded 'Connected' status means that when the laptop sleeps or the server restarts, the page shows 'Connected' over a dead socket and queues events with no feedback.", "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_visual_companion_issues_c1_idle_timeout", "label": "C1 \u2014 idle timeout too short / not configurable; WS keeps process alive", "file_type": "concept", "rationale": "A single brainstorm question can sit longer than the hardcoded 30-minute idle timeout while the user thinks or steps away, so the server dies mid-session; also shutdown() never closes upgraded sockets, so an open browser connection can keep the Node process alive past shutdown.", "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_visual_companion_issues_c2_server_death_invisible", "label": "C2 \u2014 server death is invisible to user/agent", "file_type": "concept", "rationale": "The skill is only soft-guided to check state/server-stopped, a guidance the model skips, and the browser shows a generic 'can't be reached' \u2014 so the user diagnoses manually and the agent keeps referring to a dead URL.", "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_visual_companion_issues_d1_permanent_opt_out", "label": "D1 \u2014 permanent opt-out of the visual companion (issue #892, deferred)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_visual_companion_issues_d2_free_text_feedback", "label": "D2 \u2014 free-text feedback from the browser (issue #957, deferred)", "file_type": "concept", "rationale": "The client only captures clicks on [data-choice], so a user who wants to annotate a mockup must switch to the terminal, breaking the visual flow; server persistence must also be extended because it only writes events with a truthy choice.", "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_visual_companion_issues_d3_auto_open_url", "label": "D3 \u2014 auto-open the companion URL (done in PR #1720 via --open)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_visual_companion_issues_d4_contrast_helpers", "label": "D4 \u2014 light/dark contrast helpers in the frame (PR #1683, deferred)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_visual_companion_issues_e1_terminal_vs_html_gate", "label": "E1 \u2014 hard-gate terminal-vs-HTML per question (PR #1037, workshop)", "file_type": "concept", "rationale": "The model renders HTML for purely textual content (A/B lists, clarifying questions), wasting tokens and a turn; the hard-gate wording/mechanism is behavior-shaping skill content to be designed in a workshop, not specced in the doc.", "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_visual_companion_issues_e2_state_dir_outside_tree", "label": "E2 \u2014 move session state out of the working tree (issue #975 / PR #977, deferred)", "file_type": "concept", "rationale": "Session state currently lives in <project>/.superpowers/brainstorm/ which the user must gitignore; deferred by Jesse for now and captured so it isn't lost.", "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_visual_companion_issues_e3_vendor_alpine", "label": "E3 \u2014 vendor Alpine.js for interactive mockups (PR #1639, dropped)", "file_type": "concept", "rationale": "The project is not taking on a vendored third-party dependency in the companion runtime, so the vendored Alpine build route is dropped even though the underlying need (interactive mockups) remains unpursued via this route.", "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_visual_companion_issues_e4_shell_lint_warnings", "label": "E4 \u2014 shell-lint warnings in start/stop scripts (PR #1677, opportunistic)", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_plans_2026_06_09_visual_companion_issues", "target": "skills_brainstorming_scripts_server_cjs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_06_09_visual_companion_issues", "target": "skills_brainstorming_scripts_helper_js", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_06_09_visual_companion_issues", "target": "skills_brainstorming_scripts_frame_template_html", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_06_09_visual_companion_issues", "target": "skills_brainstorming_scripts_start_server_sh", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_plans_2026_06_09_visual_companion_issues", "target": "skills_brainstorming_scripts_stop_server_sh", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md", "source_l