{"nodes": [{"id": "skills_writing_plans_skill", "label": "writing-plans Skill (implementation plans from a spec, before touching code)", "file_type": "document", "source_file": "skills/writing-plans/SKILL.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_writing_plans_skill_plan_reader_model", "label": "Plan reader: capable engineer without codebase/spec context; document decisions, not code", "file_type": "rationale", "source_file": "skills/writing-plans/SKILL.md", "source_location": "L10", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "They write idiomatic code once they know the exact interface and test and make reasonable choices where the plan leaves one open; what they cannot know is what you decided: files, names, signatures, spec values, and which tests prove each task."}, {"id": "skills_writing_plans_skill_plan_save_location", "label": "Plan save path docs/superpowers/plans/YYYY-MM-DD-<feature-name>.md", "file_type": "concept", "source_file": "skills/writing-plans/SKILL.md", "source_location": "L16", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_writing_plans_skill_scope_check", "label": "Scope Check (one plan per independent subsystem)", "file_type": "concept", "source_file": "skills/writing-plans/SKILL.md", "source_location": "L19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Each plan should produce working, testable software on its own."}, {"id": "skills_writing_plans_skill_file_structure", "label": "File Structure mapping before defining tasks", "file_type": "concept", "source_file": "skills/writing-plans/SKILL.md", "source_location": "L23", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "This is where decomposition decisions get locked in; focused files are easier to hold in context and edits to them are more reliable."}, {"id": "skills_writing_plans_skill_task_right_sizing", "label": "Task Right-Sizing (smallest unit with its own test cycle and reviewer gate)", "file_type": "concept", "source_file": "skills/writing-plans/SKILL.md", "source_location": "L34", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Fold setup, config, scaffolding and docs into the task that needs them; split only where a reviewer could meaningfully reject one task while approving its neighbor."}, {"id": "skills_writing_plans_skill_step_granularity", "label": "Step granularity: one action with a checkable result", "file_type": "concept", "source_file": "skills/writing-plans/SKILL.md", "source_location": "L43", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_writing_plans_skill_plan_document_header", "label": "Plan Document Header (Goal, Architecture, Tech Stack, Spec pointer, required execution sub-skill)", "file_type": "concept", "source_file": "skills/writing-plans/SKILL.md", "source_location": "L52", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The plan argues from the spec, so the spec travels with it and executors read both."}, {"id": "skills_writing_plans_skill_global_constraints", "label": "Global Constraints section (project-wide spec requirements copied verbatim)", "file_type": "concept", "source_file": "skills/writing-plans/SKILL.md", "source_location": "L70", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Every task's requirements implicitly include this section, so exact values reach implementers and reviewers."}, {"id": "skills_writing_plans_skill_review_focus", "label": "Review Focus section (five spec-implied input classes/failure modes no task test exercises)", "file_type": "concept", "source_file": "skills/writing-plans/SKILL.md", "source_location": "L77", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The spec is a vision document: its silence on an input is not permission for that input to break the program; each line gets a pinning test in the owning task."}, {"id": "skills_writing_plans_skill_task_structure", "label": "Task Structure template (Files, Interfaces, checkbox TDD steps, commit)", "file_type": "concept", "source_file": "skills/writing-plans/SKILL.md", "source_location": "L92", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_writing_plans_skill_interfaces_block", "label": "Per-task Interfaces block (Consumes/Produces exact signatures)", "file_type": "concept", "source_file": "skills/writing-plans/SKILL.md", "source_location": "L102", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A task's implementer sees only their own task; this block is how they learn the names and types neighboring tasks use."}, {"id": "skills_writing_plans_skill_what_a_step_contains", "label": "What a Step Contains: unambiguous, not complete", "file_type": "rationale", "source_file": "skills/writing-plans/SKILL.md", "source_location": "L140", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A plan is the set of decisions the implementer cannot make alone. A plan longer than the code it describes has written the code instead; lines that decide nothing (TBD, \"handle edge cases\") are the opposite failure. Test steps carry names and assertions, code steps carry exact signatures and spec values, bodies only for undetermined algorithms or fixed copy."}, {"id": "skills_writing_plans_skill_self_review", "label": "Self-Review checklist (spec coverage, step scan, type consistency, Review Focus, proportion)", "file_type": "concept", "source_file": "skills/writing-plans/SKILL.md", "source_location": "L163", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Run inline by the plan author, not as a subagent dispatch; fix issues in place."}, {"id": "skills_writing_plans_skill_proportion_check", "label": "Proportion check: plan length vs spec length", "file_type": "rationale", "source_file": "skills/writing-plans/SKILL.md", "source_location": "L175", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A plan several times longer than its spec is a transcript of the program; when code blocks dominate, replace bodies with signatures, test names and assertions."}, {"id": "skills_writing_plans_skill_execution_handoff", "label": "Execution Handoff (user reviews saved plan; Subagent-driven vs Native, recommend one)", "file_type": "concept", "source_file": "skills/writing-plans/SKILL.md", "source_location": "L179", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Approving an idea or scope is not approving a plan the user has not seen; an explicitly supplied execution method is preserved, otherwise one is recommended with a reason drawn from the plan."}, {"id": "skills_writing_plans_skill", "label": "Writing Plans Skill", "file_type": "document", "source_file": "skills/writing-plans/SKILL.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "skills_writing_plans_skill", "target": "skills_writing_plans_skill_plan_reader_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/writing-plans/SKILL.md", "source_location": "L10", "weight": 1.0}, {"source": "skills_writing_plans_skill", "target": "skills_writing_plans_skill_plan_save_location", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/writing-plans/SKILL.md", "source_location": "L16", "weight": 1.0}, {"source": "skills_writing_plans_skill", "target": "skills_writing_plans_skill_scope_check", "relation": "references", "c