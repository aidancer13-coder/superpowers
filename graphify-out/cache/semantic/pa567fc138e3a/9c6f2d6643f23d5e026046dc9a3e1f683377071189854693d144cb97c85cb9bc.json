{"nodes": [{"id": "skills_writing_skills_anthropic_best_practices", "label": "Skill authoring best practices", "file_type": "document", "source_file": "skills/writing-skills/anthropic-best-practices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_writing_skills_anthropic_best_practices_concise_is_key", "label": "Concise is key", "file_type": "concept", "rationale": "The context window is a public good; once a SKILL.md is loaded, every token competes with conversation history and other context. Agents are already very smart, so only add context they don't already have.", "source_file": "skills/writing-skills/anthropic-best-practices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_writing_skills_anthropic_best_practices_appropriate_degrees_of_freedom", "label": "Set appropriate degrees of freedom", "file_type": "concept", "rationale": "Match the level of specificity to the task's fragility and variability: high freedom (text instructions) when many approaches are valid, low freedom (exact scripts) when operations are fragile and consistency is critical.", "source_file": "skills/writing-skills/anthropic-best-practices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_writing_skills_anthropic_best_practices_test_with_all_models", "label": "Test with all models you plan to use", "file_type": "concept", "rationale": "Skills act as additions to models, so effectiveness depends on the underlying model; what works for Opus may need more detail for Haiku.", "source_file": "skills/writing-skills/anthropic-best-practices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_writing_skills_anthropic_best_practices_naming_conventions_gerund", "label": "Naming conventions (gerund form)", "file_type": "concept", "rationale": "Gerund-form names (verb + -ing) clearly describe the activity a Skill provides and make Skills easier to reference, organize, and search; vague names like Helper or Utils should be avoided.", "source_file": "skills/writing-skills/anthropic-best-practices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_writing_skills_anthropic_best_practices_effective_descriptions_third_person", "label": "Writing effective descriptions (third person)", "file_type": "concept", "rationale": "The description field enables Skill discovery and is injected into the system prompt; agents use it to choose the right Skill from 100+ candidates, so it must state both what the Skill does and when to use it, in third person.", "source_file": "skills/writing-skills/anthropic-best-practices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_writing_skills_anthropic_best_practices_progressive_disclosure", "label": "Progressive disclosure patterns", "file_type": "concept", "rationale": "SKILL.md serves as an overview that points agents to detailed materials as needed; only metadata is pre-loaded, so keep the body under 500 lines and split content into separate files loaded only when relevant.", "source_file": "skills/writing-skills/anthropic-best-practices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_writing_skills_anthropic_best_practices_one_level_deep_references", "label": "Keep references one level deep", "file_type": "concept", "rationale": "Agents may partially read files that are referenced from other referenced files (e.g. head -100), resulting in incomplete information, so all reference files should link directly from SKILL.md.", "source_file": "skills/writing-skills/anthropic-best-practices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_writing_skills_anthropic_best_practices_workflows_with_checklists", "label": "Use workflows with checklists for complex tasks", "file_type": "concept", "rationale": "Breaking complex operations into clear sequential steps with a copyable checklist prevents agents from skipping critical validation and helps both author and agent track progress.", "source_file": "skills/writing-skills/anthropic-best-practices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_writing_skills_anthropic_best_practices_feedback_loops", "label": "Implement feedback loops (validate-fix-repeat)", "file_type": "concept", "rationale": "The run-validator, fix-errors, repeat pattern catches errors early and greatly improves output quality; the validator can be a script or a reference document the agent checks against.", "source_file": "skills/writing-skills/anthropic-best-practices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_writing_skills_anthropic_best_practices_evaluation_driven_development", "label": "Build evaluations first", "file_type": "concept", "rationale": "Creating evaluations before writing extensive documentation ensures the Skill solves real problems rather than documenting imagined ones; establish a baseline without the Skill, then iterate.", "source_file": "skills/writing-skills/anthropic-best-practices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_writing_skills_anthropic_best_practices_iterative_agent_development", "label": "Develop Skills iteratively with the agent (Agent A / Agent B)", "file_type": "concept", "rationale": "Work with one agent instance (Agent A) to design instructions and test with another (Agent B) on real tasks; iterating based on observed Agent B behavior rather than assumptions improves Skills.", "source_file": "skills/writing-skills/anthropic-best-practices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_writing_skills_anthropic_best_practices_solve_dont_punt", "label": "Solve, don't punt (explicit error handling, no voodoo constants)", "file_type": "concept", "rationale": "Scripts in Skills should handle error conditions explicitly instead of failing and letting the agent figure it out, and configuration values should be justified to avoid magic numbers (Ousterhout's law).", "source_file": "skills/writing-skills/anthropic-best-practices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_writing_skills_anthropic_best_practices_utility_scripts", "label": "Provide utility scripts", "file_type": "concept", "rationale": "Pre-made scripts are more reliable than generated code, save tokens and time, and ensure consistency; make clear whether the agent should execute a script or read it as reference.", "source_file": "skills/writing-skills/anthropic-best-practices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_writing_skills_anthropic_best_practices_verifiable_intermediate_outputs", "label": "Create verifiable intermediate outputs (plan-validate-execute)", "file_type": "concept", "rationale": "Having the agent produce a structured plan file (e.g. changes.json) that a script validates before execution catches errors early, is machine-verifiable, and makes planning reversible without touching originals.", "source_file": "skills/writing-skills/anthropic-best-practices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_writing_skills_anthropic_best_practices_forward_slash_paths", "label": "Avoid Windows-style paths (use forward slashes)", "file_type": "concept", "rationale": "Unix-style paths with forward slashes work across all platforms, while backslash paths cause errors on Unix systems, even when the Skill is authored on Windows.", "source_file": "skills/writing-skills/anthropic-best-practices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_writing_skills_anthropic_best_practices_default_not_options", "label": "Provide a default, don't offer too many options", "file_type": "concept", "rationale": "Presenting multiple approaches is confusing; give one default with an escape hatch for the alternative case instead of a menu of libraries or options.", "source_file": "skills/writing-skills/anthropic-best-practices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_writing_skills_anthropic_best_practices_mcp_fully_qualified_tool_names", "label": "Use fully qualified MCP tool names", "file_type": "concept", "rationale": "MCP tools must be referenced as ServerName:tool_name because without the server prefix agents may fail to locate the tool when multiple MCP servers are available.", "source_file": "skills/writing-skills/anthropic-best-practices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_writing_skills_anthropic_best_practices_package_dependencies_explicit", "label": "List and verify package dependencies", "file_type": "concept", "rationale": "Skills run in code execution environments with platform-specific limitations (e.g. the API has no network access and no runtime package installation), so required packages must be listed and never assumed installed.", "source_file": "skills/writing-skills/anthropic-best-practices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_writing_skills_anthropic_best_practices_runtime_environment_filesystem", "label": "Runtime environment (filesystem-based access)", "file_type": "concept", "rationale": "Metadata is pre-loaded at startup, files are read on-demand from the filesystem, and scripts execute without their contents consuming context tokens; this filesystem-based model is what enables progressive disclosure.", "source_file": "skills/writing-skills/anthropic-best-practices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "skills_writing_skills_anthropic_best_practices_checklist_effective_skills", "label": "Checklist for effective Skills", "file_type": "concept", "rationale": "A pre-sharing quality gate covering core quality (specific description, under 500 lines, consistent terminology, one-level-deep references), code and scripts (explicit error handling, validation steps), and testing (evaluations, all model tiers).", "source_file": "skills/writing-skills/anthropic-best-practices.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "skills_writing_skills_anthropic_best_practices", "target": "skills_writing_skills_anthropic_best_practices_concise_is_key", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/writing-skills/anthropic-best-practices.md", "source_location": null, "weight": 1.0}, {"source": "skills_writing_skills_anthropic_best_practices", "target": "skills_writing_skills_anthropic_best_practices_appropriate_degrees_of_freedom", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "skills/writing-skills/anthropic-best-practices.md", "source_location": null, "weight": 1.0}, {"source": "skills_writing_skills_anthropic_best_practices", "target": "skills_writing_skills_anthropic_best_practices_test_with_all_models", "relation": "references", "confidence": "EXTRACTED", "confide