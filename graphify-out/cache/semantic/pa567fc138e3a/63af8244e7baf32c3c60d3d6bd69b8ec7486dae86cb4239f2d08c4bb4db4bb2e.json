a_new_harness", "target": "docs_porting_to_a_new_harness_rule_ship_via_install_mechanism", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/porting-to-a-new-harness.md", "source_location": null, "weight": 1.0}, {"source": "docs_porting_to_a_new_harness", "target": "docs_porting_to_a_new_harness_windows_polyglot_hook", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/porting-to-a-new-harness.md", "source_location": null, "weight": 1.0}, {"source": "docs_porting_to_a_new_harness_capability_checklist", "target": "docs_porting_to_a_new_harness_hard_requirement_session_start_injection", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/porting-to-a-new-harness.md", "source_location": null, "weight": 1.0}, {"source": "docs_porting_to_a_new_harness_definition_of_done", "target": "docs_porting_to_a_new_harness_acceptance_test", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/porting-to-a-new-harness.md", "source_location": null, "weight": 1.0}, {"source": "docs_porting_to_a_new_harness_porting_procedure", "target": "docs_porting_to_a_new_harness_shape_a_shell_hook", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/porting-to-a-new-harness.md", "source_location": null, "weight": 1.0}, {"source": "docs_porting_to_a_new_harness_porting_procedure", "target": "docs_porting_to_a_new_harness_shape_b_in_process_plugin", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/porting-to-a-new-harness.md", "source_location": null, "weight": 1.0}, {"source": "docs_porting_to_a_new_harness_porting_procedure", "target": "docs_porting_to_a_new_harness_shape_c_instructions_file", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/porting-to-a-new-harness.md", "source_location": null, "weight": 1.0}, {"source": "docs_porting_to_a_new_harness_distribution_channels", "target": "docs_porting_to_a_new_harness_rule_ship_via_install_mechanism", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/porting-to-a-new-harness.md", "source_location": null, "weight": 1.0}, {"source": "docs_porting_to_a_new_harness_shape_a_shell_hook", "target": "docs_porting_to_a_new_harness_shape_b_in_process_plugin", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/porting-to-a-new-harness.md", "source_location": null, "weight": 1.0}, {"source": "docs_porting_to_a_new_harness_shape_b_in_process_plugin", "target": "docs_porting_to_a_new_harness_shape_c_instructions_file", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/porting-to-a-new-harness.md", "source_location": null, "weight": 1.0}, {"source": "docs_porting_to_a_new_harness_shape_a_shell_hook", "target": "docs_porting_to_a_new_harness_shape_c_instructions_file", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/porting-to-a-new-harness.md", "source_location": null, "weight": 1.0}, {"source": "docs_porting_to_a_new_harness_acceptance_test", "target": "docs_porting_to_a_new_harness_hard_requirement_session_start_injection", "relation": "conceptually_related_to", "confidence": "INFERRED", "confidence_score": 0.75, "source_file": "docs/porting-to-a-new-harness.md", "source_location": null, "weight": 1.0}], "hyperedges": [{"id": "integration_shapes", "label": "The Three Integration Shapes", "nodes": ["docs_porting_to_a_new_harness_shape_a_shell_hook", "docs_porting_to_a_new_harness_shape_b_in_process_plugin", "docs_porting_to_a_new_harness_shape_c_instructions_file"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/porting-to-a-new-harness.md"}, {"id": "core_invariants", "label": "Two Invariant Rules That Make Cross-Harness Porting Work", "nodes": ["docs_porting_to_a_new_harness", "docs_porting_to_a_new_harness_rule_skills_name_actions", "docs_porting_to_a_new_harness_rule_ship_via_install_mechanism"], "relation": "form", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/porting-to-a-new-harness.md"}, {"id": "porting_workflow", "label": "End-to-End Porting and Acceptance Workflow", "nodes": ["docs_porting_to_a_new_harness", "docs_porting_to_a_new_harness_porting_procedure", "docs_porting_to_a_new_harness_acceptance_test", "docs_porting_to_a_new_harness_definition_of_done"], "relation": "participate_in", "confidence": "INFERRED", "confidence_score": 0.85, "source_file": "docs/porting-to-a-new-harness.md"}]}