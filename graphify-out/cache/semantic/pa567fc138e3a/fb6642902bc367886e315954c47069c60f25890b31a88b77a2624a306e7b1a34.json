{"nodes": [{"id": "release_notes", "label": "Superpowers Release Notes", "file_type": "document", "source_file": "RELEASE-NOTES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "superpowers_project", "label": "Superpowers Project", "file_type": "concept", "rationale": "The overall subject of RELEASE-NOTES.md: an open-source collection of skills for AI coding agents (obra/superpowers). Treated as a named project concept because the release notes track its releases, skills, and harness integrations.", "source_file": "RELEASE-NOTES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "subagent_driven_development", "label": "Subagent-Driven Development (SDD) Skill", "file_type": "concept", "rationale": "Named skill repeatedly featured across releases (review redesign, plan-scoped workspaces, native vs subagent execution). A core named skill of the project, so extracted as a concept.", "source_file": "RELEASE-NOTES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "brainstorming", "label": "Brainstorming Skill", "file_type": "concept", "rationale": "Named core skill (design/requirements phase, visual companion, hard gates). Extracted as a named concept; it is the entry point of the skill pipeline.", "source_file": "RELEASE-NOTES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "writing_plans", "label": "Writing Plans Skill", "file_type": "concept", "rationale": "Named core skill that produces implementation plans (Review Focus section, self-review loops). Part of the brainstorm -> plan -> execute pipeline.", "source_file": "RELEASE-NOTES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "executing_plans", "label": "Executing Plans Skill", "file_type": "concept", "rationale": "Named core skill for running a plan inline; rebuilt as a 'Native' execution mode in v6.4.1. Part of the plan -> execute pipeline.", "source_file": "RELEASE-NOTES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "using_superpowers", "label": "Using Superpowers Bootstrap Skill", "file_type": "concept", "rationale": "Named bootstrap skill injected into every session (size trimmed in v6.1.0, rationalization tables, SUBAGENT-STOP gate). It is the project's entry/bootstrap mechanism.", "source_file": "RELEASE-NOTES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "test_driven_development", "label": "Test-Driven Development (TDD) Skill", "file_type": "concept", "rationale": "Named core skill (green = project suite, testing-anti-patterns reference, 'Why Order Matters' rationalization rows). Extracted as a named concept.", "source_file": "RELEASE-NOTES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "systematic_debugging", "label": "Systematic Debugging Skill", "file_type": "concept", "rationale": "Named core skill (bundles root-cause-tracing, defense-in-depth, condition-based-waiting, find-polluter.sh). Extracted as a named concept.", "source_file": "RELEASE-NOTES.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "release_notes", "label": "Superpowers Release Notes", "file_type": "document", "source_file": "RELEASE-NOTES.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "superpowers_project", "label": "Superpowers Project", "file_type": "concept", "source_file": "RELEASE-NOTES.md", "source_location": "L1", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "release_notes_v6_4_2", "label": "v6.4.2 (2026-09-25): leaner plans from writing-plans", "file_type": "concept", "source_file": "RELEASE-NOTES.md", "source_location": "L3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Some frontier models (including Opus 5.5) got overzealous during plan writing and sometimes implemented the whole project while designing the plan; the new skill keeps planning focused. Reproducing the report, scratch builds went away and plans took ~1/4 the time and ~1/3 the tokens, while still executing 9/9 against planted-defect probes on Sonnet 5. Reported by Harper Reed (#2333)."}, {"id": "release_notes_v6_4_1", "label": "v6.4.1 (2026-09-18): diagnosing-superpowers, Native execution, OpenCode 2.0 / Muse / Qwen Code support", "file_type": "concept", "source_file": "RELEASE-NOTES.md", "source_location": "L19", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "v6.4.0 was never shipped; the proving-it-works-with-a-movie skill was held back for robustness work."}, {"id": "release_notes_v6_3_0", "label": "v6.3.0 (2026-08-12): Devin CLI and Hermes Agent support, brainstorming ceremony scaling, SDD conflict rulings, Spec: pointer in plans", "file_type": "concept", "source_file": "RELEASE-NOTES.md", "source_location": "L78", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "release_notes_v6_2_0", "label": "v6.2.0 (2026-07-23): plan-scoped SDD workspace, review-fix loop resume, compression campaign, Git Bash SessionStart", "file_type": "concept", "source_file": "RELEASE-NOTES.md", "source_location": "L117", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "release_notes_v6_0_0", "label": "v6.0.0 (2026-06-16): one reviewer per task, plan Global Constraints/Interfaces, visual companion security, vendor-neutral skills, Kimi/Pi/Antigravity", "file_type": "concept", "source_file": "RELEASE-NOTES.md", "source_location": "L198", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "In evals Claude Code and Codex produced similar high-quality results roughly twice as fast with almost 50% fewer tokens."}, {"id": "release_notes_v5_1_0", "label": "v5.1.0 (2026-04-30): worktree skills rewrite, code-reviewer agent removed, legacy slash commands removed", "file_type": "concept", "source_file": "RELEASE-NOTES.md", "source_location": "L296", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "release_notes_v5_0_6", "label": "v5.0.6 (2026-03-24): inline self-review replaces subagent review loops", "file_type": "concept", "source_file": "RELEASE-NOTES.md", "source_location": "L395", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The subagent review loop added ~25 min per run without measurably improving plan quality (5 versions x 5 trials); inline self-review catches 3-5 real bugs in ~30s."}, {"id": "release_notes_v5_0_0", "label": "v5.0.0 (2026-03-09): specs/plans directory restructure, visual brainstorming companion, document review system, SDD mandatory on capable harnesses", "file_type": "concept", "source_file": "RELEASE-NOTES.md", "source_location": "L582", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "release_notes_v4_0_0", "label": "v4.0.0 (2025-12-17): two-stage SDD code review, DOT flowcharts as executable specs, skill consolidation", "file_type": "concept", "source_file": "RELEASE-NOTES.md", "source_location": "L888", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "release_notes_v2_0_0", "label": "v2.0.0: skills repository separation (obra/superpowers-skills)", "file_type": "concept", "source_file": "RELEASE-NOTES.md", "source_location": "L1245", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Turned the monolithic plugin into a lightweight shim managing a local clone so skills auto-update, version independently and accept community PRs via git workflows."}, {"id": "release_notes_no_placeholders_section", "label": "No Placeholders section (writing-plans; added v5.0.6, replaced by \"What a Step Contains\" in v6.4.2)", "file_type": "concept", "source_file": "RELEASE-NOTES.md", "source_location": "L403", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "release_notes_agents_md_canonical", "label": "AGENTS.md as canonical contributor guidelines (CLAUDE.md removed in v6.4.2)", "file_type": "concept", "source_file": "RELEASE-NOTES.md", "source_location": "L75", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Claude Code reads AGENTS.md directly only when no CLAUDE.md exists, so the one-line CLAUDE.md pointer would have hidden the real guidelines; the earlier AGENTS.md->CLAUDE.md symlink was rejected by Muse's installer."}, {"id": "release_notes_native_execution", "label": "Native (inline) execution mode for executing-plans (#2318)", "file_type": "concept", "source_file": "RELEASE-NOTES.md", "source_location": "L33", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "executing-plans was a 64-line stub that measured the same as no plugin; it was rebuilt under SDD's workspace, ledger and stopping rules with one fresh whole-branch review on the most capable model, making it the cheapest way to run a plan."}, {"id": "release_notes_reasonable_user_review_standard", "label": "Reviewers judge spec-silent behavior by reasonable-user expectation, with a \"Declined to judge\" list (#2319)", "file_type": "concept", "source_file": "RELEASE-NOTES.md", "source_location": "L47", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "So a crash on an input the spec never named no longer slides through as Minor."}, {"id": "release_notes_suite_defines_green", "label": "TDD: the project's suite defines green, not just the task's test file (#2110)", "file_type": "concept", "source_file": "RELEASE-NOTES.md", "source_location": "L52", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Sessions ran only the named test file in 11 of 12 probe runs, so broken neighboring tests went unseen."}, {"id": "release_notes_plan_scoped_sdd_workspace", "label": "Plan-scoped SDD workspace (.superpowers/sdd/<plan-basename>/; same-basename collision fix in v6.4.1)", "file_type": "concept", "source_file": "RELEASE-NOTES.md", "source_location": "L123", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "A follow-up plan in the same tree could read the previous plan's ledger as its own progress; plan-scoping makes the answer structural. v6.4.1 fixed same-basename plans sharing a directory where task-brief overwrote the other plan's brief."}, {"id": "release_notes_interpreter_invoked_scripts", "label": "Bundled scripts invoked through their interpreter (bash scripts/foo.sh, node render-graphs.js)", "file_type": "rationale", "source_file": "RELEASE-NOTES.md", "source_location": "L68", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Packagers (Codex marketplace, MiniMax Code) stripped executable bits, so every documented command failed with Permission denied (#2301, #2134, #2040)."}, {"id": "release_notes_opencode_v2_support", "label": "OpenCode 2.0.4+ support (V2 native skill API; bootstrap survives continuation, restart, forks, compaction; child sessions excluded) (#2106, #2306)", "file_type": "concept", "source_file": "RELEASE-NOTES.md", "source_location": "L62", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "release_notes_review_fix_loop", "label": "SDD review-fix loop resumes the implementer; scoped re-review; five-round circuit breaker", "file_type": "concept", "source_file": "RELEASE-NOTES.md", "source_location": "L124", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "release_notes_compression_campaign", "label": "Branch-wide skill compression campaign (recap/persuasion prose removed, arguments folded into rationalization tables)", "file_type": "rationale", "source_file": "RELEASE-NOTES.md", "source_location": "L128", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Prose aimed at a reader who already invoked the skill was dead weight; each cut was micro-tested with subagent probes, and the one cut that measurably degraded behavior (TDD \"Why Order Matters\", 8/10 -> 5/10) was reworked into rationalization rows."}, {"id": "release_notes_windows_sessionstart_hook_fixes", "label": "Windows SessionStart hook fixes (run-hook.cmd polyglot wrapper, quoting fixes, Git Bash dispatch via shell: bash)", "file_type": "concept", "source_file": "RELEASE-NOTES.md", "source_location": "L137", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "PowerShell parsed the quoted command as an expression and cmd.exe quote-stripping truncated paths with metacharacters, so the bootstrap silently never loaded."}, {"id": "release_notes_visual_companion_security", "label": "Brainstorming visual companion per-session key security model (closes #1014)", "file_type": "concept", "source_file": "RELEASE-NOTES.md", "source_location": "L242", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The companion server had no authentication: anyone reaching the port could read the brainstorm or inject events treated as user input, including the DNS-rebinding case an origin allowlist cannot catch."}, {"id": "release_notes_vendor_neutral_skills", "label": "One set of skills, every harness: action-based vocabulary plus per-harness tool references", "file_type": "concept", "source_file": "RELEASE-NOTES.md", "source_location": "L258", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "release_notes_two_stage_code_review", "label": "Two-stage SDD code review (spec compliance then code quality); collapsed into one reviewer in v6.0.0", "file_type": "concept", "source_file": "RELEASE-NOTES.md", "source_location": "L892", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Catches code that is well written but does not match what was requested."}, {"id": "release_notes_worktree_skills_rewrite", "label": "Worktree skills rewrite: environment detection, consent, native tool preference, provenance-based cleanup (PR #1121)", "file_type": "concept", "source_file": "RELEASE-NOTES.md", "source_location": "L304", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "release_notes_code_reviewer_agent_removed", "label": "superpowers:code-reviewer named agent removed; merged into code-reviewer.md dispatch template (PR #1299)", "file_type": "concept", "source_file": "RELEASE-NOTES.md", "source_location": "L301", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Single source of truth: the persona/checklist lived in both the agent and the skill template and drifted independently."}, {"id": "release_notes_opencode_bootstrap_caching", "label": "OpenCode bootstrap content cached at module level (getBootstrapContent, #1202)", "file_type": "concept", "source_file": "RELEASE-NOTES.md", "source_location": "L335", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The experimental.chat.messages.transform hook fires on every agent step, so re-reading and re-parsing the bootstrap file each step was wasteful."}, {"id": "release_notes_document_review_system", "label": "Document review system (spec/plan reviewer subagent loops; added v5.0.0, replaced by inline self-review in v5.0.6)", "file_type": "concept", "source_file": "RELEASE-NOTES.md", "source_location": "L618", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "release_notes_instruction_priority_hierarchy", "label": "Instruction priority hierarchy (user instructions > Superpowers skills > default system prompt)", "file_type": "concept", "source_file": "RELEASE-NOTES.md", "source_location": "L648", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "release_notes_description_trap", "label": "The Description Trap: skill descriptions must be trigger-only", "file_type": "rationale", "source_file": "RELEASE-NOTES.md", "source_location": "L948", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Descriptions containing workflow summaries override the flowchart; the model follows the short description instead of reading the detailed process."}], "edges": [{"source": "release_notes", "target": "superpowers_project", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RELEASE-NOTES.md", "source_location": null, "weight": 1.0}, {"source": "release_notes", "target": "subagent_driven_development", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RELEASE-NOTES.md", "source_location": null, "weight": 1.0}, {"source": "release_notes", "target": "brainstorming", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RELEASE-NOTES.md", "source_location": null, "weight": 1.0}, {"source": "release_notes", "target": "writing_plans", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RELEASE-NOTES.md", "source_location": null, "weight": 1.0}, {"source": "release_notes", "target": "executing_plans", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "RELEASE-NOTES.md", "source_location": null, "weight": 1.0}, {"source": "release_notes", "target": "using_superp