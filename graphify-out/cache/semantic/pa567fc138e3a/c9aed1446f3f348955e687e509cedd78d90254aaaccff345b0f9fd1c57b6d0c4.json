{"nodes": [{"id": "docs_superpowers_plans_2026_02_19_visual_brainstorming_refactor", "label": "Visual Brainstorming Refactor Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-02-19-visual-brainstorming-refactor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_02_19_visual_brainstorming_refactor_nonblocking_architecture", "label": "Browser Displays, Terminal Commands Architecture", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-02-19-visual-brainstorming-refactor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Refactors visual brainstorming from a blocking TUI feedback model to a non-blocking model: the browser becomes an interactive display while the terminal stays the conversation channel, and the server writes user events to a per-screen .events file that Claude reads on its next turn, eliminating wait-for-feedback.sh and all TaskOutput blocking."}, {"id": "docs_superpowers_plans_2026_02_19_visual_brainstorming_refactor_events_file", "label": ".events File Mechanism", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-02-19-visual-brainstorming-refactor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The server appends each browser interaction (click/choice) as a JSON line to a per-screen .events file and clears it when a new screen is pushed; Claude reads it on the next turn and merges the structured interaction data with the user's terminal text, where the terminal message is the primary feedback."}, {"id": "docs_superpowers_plans_2026_02_19_visual_brainstorming_refactor_helper_js", "label": "helper.js Simplification", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-02-19-visual-brainstorming-refactor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Narrows the client-side helper.js by removing sendToClaude, window.send, form/input handlers and the pageshow listener, keeping only click capture on [data-choice] elements plus indicator-bar updates and a minimal window.brainstorm API (send/choice)."}, {"id": "docs_superpowers_plans_2026_02_19_visual_brainstorming_refactor_frame_template", "label": "frame-template.html Selection Indicator Bar", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-02-19-visual-brainstorming-refactor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Replaces the feedback-footer HTML/CSS with a selection indicator bar and a <!-- CONTENT --> placeholder, and swaps wrapInFrame for comment-based content injection, so fragments get a header/theme/indicator while full documents are served as-is."}, {"id": "docs_superpowers_plans_2026_02_19_visual_brainstorming_refactor_visual_companion_rewrite", "label": "visual-companion.md Non-Blocking Loop Rewrite", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-02-19-visual-brainstorming-refactor.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Rewrites the brainstorming skill's loop to the non-blocking flow: write a fresh semantic-named HTML file, end the turn and tell the user to respond in the terminal, then on the next turn read $SCREEN_DIR/.events and merge it with the terminal text, iterating or advancing only after the current screen is validated."}], "edges": [{"source": "docs_superpowers_plans_2026_02_19_visual_brainstorming_refactor", "target": "docs_superpowers_specs_2026_02_19_visual_brainstorming_refactor_design", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/plans/2026-02-19-visual-brainstorming-refac