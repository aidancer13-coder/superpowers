{"nodes": [{"id": "docs_superpowers_plans_2026_06_09_sdd_task_scoped_review_dispatch", "label": "SDD Task-Scoped Review Dispatch Implementation Plan", "file_type": "document", "rationale": "Goal: scope SDD's per-task reviews to the task (diff-first reading, justified broadening, no redundant test runs) while final branch review stays broad. Four prose edits to the subagent-driven-development skill plus one new eval scenario; skills/requesting-code-review/ is deliberately untouched.", "source_file": "docs/superpowers/plans/2026-06-09-sdd-task-scoped-review-dispatch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_sdd_task_scoped_review_dispatch_task_1_quality_reviewer_prompt_self_contained", "label": "Task 1: Rewrite per-task quality reviewer prompt as self-contained", "file_type": "concept", "rationale": "The current file delegates to requesting-code-review/code-reviewer.md, which is a merge-readiness review (architecture, security, production readiness, 'Ready to merge?'); the per-task gate must be task-scoped, so the whole file is replaced with a self-contained task-scoped template.", "source_file": "docs/superpowers/plans/2026-06-09-sdd-task-scoped-review-dispatch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_sdd_task_scoped_review_dispatch_task_2_spec_reviewer_cleanups", "label": "Task 2: Spec reviewer prompt cleanups (judge from diff, grounded skepticism, warning verdict channel)", "file_type": "concept", "rationale": "Four exact edits: judge spec compliance from the diff alone, trim the worktree clause from the read-only section, replace 'finished suspiciously quickly' with treating the report as unverified claims, and add a third verdict channel for requirements that cannot be verified from the diff alone.", "source_file": "docs/superpowers/plans/2026-06-09-sdd-task-scoped-review-dispatch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_sdd_task_scoped_review_dispatch_task_3_implementer_rerun_tests_after_fix", "label": "Task 3: Implementer prompt \u2014 re-run tests after fixing review findings", "file_type": "concept", "rationale": "The reviewers' 'don't re-run the implementer's tests' rule assumes the implementer re-runs tests after every fix; an 'After Review Findings' section makes that real, since the implementer's report is the test evidence.", "source_file": "docs/superpowers/plans/2026-06-09-sdd-task-scoped-review-dispatch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_sdd_task_scoped_review_dispatch_task_4_skill_md_controller_changes", "label": "Task 4: SKILL.md controller changes (final-review pointer, model judgment, warning-item handling)", "file_type": "concept", "rationale": "Six exact edits: point all three final-review flowchart nodes at the broad requesting-code-review template, let the controller choose the review model by judgment scaled to the diff, add controller guidance for handling cannot-verify items and for constructing reviewer prompts, add the final-review pointer to the Prompt Templates list, adopt 'Task quality: Approved' verdict vocabulary, and reword the integration bullet.", "source_file": "docs/superpowers/plans/2026-06-09-sdd-task-scoped-review-dispatch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_sdd_task_scoped_review_dispatch_task_5_planted_dry_defect_eval_scenario", "label": "Task 5: New eval scenario \u2014 per-task quality reviewer catches a planted DRY violation", "file_type": "concept", "rationale": "The fixture plan's Task 2 implementation snippet duplicates Task 1's formatting logic verbatim; the duplication is spec-compliant (requirements only describe behavior), so the spec reviewer should pass it and the per-task quality reviewer is the gate under test. Lives in the evals submodule on its own branch.", "source_file": "docs/superpowers/plans/2026-06-09-sdd-task-scoped-review-dispatch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_sdd_task_scoped_review_dispatch_task_6_static_verification_sweep", "label": "Task 6: Static verification sweep", "file_type": "concept", "rationale": "Grep checks for dangling references (requesting-code-review matches only in SKILL.md; no 'Ready to merge' left), shell lint passes, and cross-platform tool tables still list code-quality-reviewer as a reviewer template.", "source_file": "docs/superpowers/plans/2026-06-09-sdd-task-scoped-review-dispatch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_sdd_task_scoped_review_dispatch_task_7_live_before_after_evals", "label": "Task 7: Live before/after evals (maintainer-gated)", "file_type": "concept", "rationale": "Live quorum runs launch agent CLIs in permissive modes, so they are trusted-maintainer operation requiring ANTHROPIC_API_KEY; pass bar is no regression in the four pre-existing scenarios plus the new planted-defect scenario passing, with reviewer tool-call counts compared manually.", "source_file": "docs/superpowers/plans/2026-06-09-sdd-task-scoped-review-dispatch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_sdd_task_scoped_review_dispatch_decision_two_stages_stay_separate", "label": "Decision: the two review stages stay separate", "file_type": "concept", "rationale": "Per-task reviews are task-scoped gates; the broad review happens once, at the final whole-branch review. Settled in the design spec, not re-litigated here.", "source_file": "docs/superpowers/plans/2026-06-09-sdd-task-scoped-review-dispatch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_sdd_task_scoped_review_dispatch_decision_final_review_broad_untouched", "label": "Decision: requesting-code-review skill stays broad and untouched", "file_type": "concept", "rationale": "skills/requesting-code-review/ is deliberately untouched; the final whole-branch review keeps using its merge-readiness code-reviewer.md template.", "source_file": "docs/superpowers/plans/2026-06-09-sdd-task-scoped-review-dispatch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_sdd_task_scoped_review_dispatch_decision_coordinator_keeps_model_judgment", "label": "Decision: coordinator keeps model judgment", "file_type": "concept", "rationale": "For review tasks the controller chooses the model with the same judgment, scaled to the diff's size, complexity, and risk \u2014 a small mechanical diff does not need the most capable model; a subtle concurrency change does.", "source_file": "docs/superpowers/plans/2026-06-09-sdd-task-scoped-review-dispatch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_sdd_task_scoped_review_dispatch_decision_full_rereviews_stay", "label": "Decision: full re-reviews stay", "file_type": "concept", "rationale": "When an item is confirmed as a real gap (e.g. a controller-confirmed cannot-verify item), the task is sent back to the implementer and re-reviewed in full; this is settled in the design spec.", "source_file": "docs/superpowers/plans/2026-06-09-sdd-task-scoped-review-dispatch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_sdd_task_scoped_review_dispatch_concept_diff_first_task_scoped_gate", "label": "Concept: diff-first, task-scoped review gate", "file_type": "concept", "rationale": "Start from the diff; read changed files first; inspect code outside the diff only to evaluate a concrete, nameable risk (cross-cutting changes are legitimate named risks); do not crawl the codebase by default, and do not re-run tests the implementer already ran.", "source_file": "docs/superpowers/plans/2026-06-09-sdd-task-scoped-review-dispatch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_sdd_task_scoped_review_dispatch_concept_warning_cannot_verify_verdict", "label": "Concept: cannot-verify-from-diff warning verdict channel", "file_type": "concept", "rationale": "If a requirement cannot be verified from the diff alone (it lives in unchanged code or spans tasks), the spec reviewer reports it as a warning item instead of broadening the search; the controller must resolve each item itself before marking the task complete, treating a confirmed real gap as a failed spec review.", "source_file": "docs/superpowers/plans/2026-06-09-sdd-task-scoped-review-dispatch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_sdd_task_scoped_review_dispatch_concept_rerun_tests_after_review_fix", "label": "Concept: implementer re-runs covering tests after fixing review findings", "file_type": "concept", "rationale": "Reviewers will not re-run tests for the implementer \u2014 the implementer's report is the test evidence \u2014 so after fixing reviewer findings the implementer must re-run the tests that cover the amended code and include the results in the fix report.", "source_file": "docs/superpowers/plans/2026-06-09-sdd-task-scoped-review-dispatch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_sdd_task_scoped_review_dispatch_code_quality_reviewer_prompt", "label": "Component: subagent-driven-development code-quality-reviewer-prompt.md", "file_type": "concept", "rationale": "The per-task quality reviewer prompt template, rewritten in Task 1 to be self-contained and task-scoped: read-only, diff-first, no re-running the suite, verdict is 'Task quality: Approved | Needs fixes'.", "source_file": "docs/superpowers/plans/2026-06-09-sdd-task-scoped-review-dispatch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_sdd_task_scoped_review_dispatch_spec_reviewer_prompt", "label": "Component: subagent-driven-development spec-reviewer-prompt.md", "file_type": "concept", "rationale": "The spec compliance reviewer prompt template, edited in Task 2 to judge from the diff, ground skepticism, and report a third warning verdict channel.", "source_file": "docs/superpowers/plans/2026-06-09-sdd-task-scoped-review-dispatch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_sdd_task_scoped_review_dispatch_implementer_prompt", "label": "Component: subagent-driven-development implementer-prompt.md", "file_type": "concept", "rationale": "The implementer prompt template, edited in Task 3 to add an 'After Review Findings' section requiring test re-runs after fixes.", "source_file": "docs/superpowers/plans/2026-06-09-sdd-task-scoped-review-dispatch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_sdd_task_scoped_review_dispatch_skill_md", "label": "Component: subagent-driven-development SKILL.md (controller)", "file_type": "concept", "rationale": "The SDD controller skill file, edited in Task 4 for final-review pointer, review-model judgment, warning-item handling, reviewer prompt construction rules, and verdict vocabulary.", "source_file": "docs/superpowers/plans/2026-06-09-sdd-task-scoped-review-dispatch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_sdd_task_scoped_review_dispatch_requesting_code_reviewer_template", "label": "Component: requesting-code-review code-reviewer.md (final whole-branch review template)", "file_type": "concept", "rationale": "The merge-readiness review template (architecture, security, production readiness, 'Ready to merge?') used once at the final whole-branch review; deliberately untouched by this plan.", "source_file": "docs/superpowers/plans/2026-06-09-sdd-task-scoped-review-dispatch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_plans_2026_06_09_sdd_task_scoped_review_dispatch_finishing_submodule_pointer_bump", "label": "Finishing: evals submodule commit to superpowers-evals, then parent pointer bump", "file_type": "concept", "rationale": "Per evals/CLAUDE.md the parent submodule-pointer bump is part of propagation, not optional: the evals commit lands in superpowers-evals first, then the branch bumps the evals pointer, then finishing-a-development-branch runs (PRs against superpowers target dev).", "source_file": "docs/superpowers/plans/2026-06-09-sdd-task-scoped-review-dispatch.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_plans_2026_06_09_sdd_task_scoped_review_dispatch", "target": "docs_superpowers_plans_2026_06_09_sdd_task_scoped_review_dispatch_task_1_quality_reviewer_prompt_self_contained", "relation": "references", "confidence": "EXTRACTED", "confidence_s