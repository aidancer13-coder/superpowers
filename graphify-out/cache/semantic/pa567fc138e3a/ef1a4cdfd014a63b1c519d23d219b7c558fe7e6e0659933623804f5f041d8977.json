{"nodes": [{"id": "docs_superpowers_specs_2026_08_05_hermes_version_bump_wiring_design", "label": "Hermes Version-Bump Wiring Design", "file_type": "document", "source_file": "docs/superpowers/specs/2026-08-05-hermes-version-bump-wiring-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_08_05_hermes_version_bump_wiring_design_readonly_preflight", "label": "Read-only preflight for version bump", "file_type": "concept", "rationale": "Before a version bump writes any manifest, run one read-only preflight that validates the required tools and reads every present declared manifest through the dispatcher; this prevents a deterministic YAML failure from occurring after earlier JSON files have already been updated. It is the only reliability addition - it does not make the script transactional or redesign existing audit/error-status behavior; missing-file behavior stays unchanged and --help still works without jq or yq.", "source_file": "docs/superpowers/specs/2026-08-05-hermes-version-bump-wiring-design.md", "source_location": "## Design", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "docs_superpowers_specs_2026_08_05_hermes_version_bump_wiring_design", "target": "docs_superpowers_plans_2026_08_06_hermes_version_bump_wiring_plan", "relation": "rationale_for", "confidence": "INFERRED", "confidence_score": 0.95, "source_file": "docs/superpowers/specs/2026-08-05-hermes-version-bump-wiring-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_08_05_hermes_version_bump_wiring_design", "target": "docs_superpowers_specs_2026_08_05_hermes_version_bump_wiring_design_readonly_preflight", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-08-05-hermes-version-bump-wiring-design.md", "source_location": "## Design", "weight