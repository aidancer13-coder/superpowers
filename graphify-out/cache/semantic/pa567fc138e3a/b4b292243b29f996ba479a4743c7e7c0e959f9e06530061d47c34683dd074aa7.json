{"nodes": [{"id": "docs_superpowers_plans_2026_03_23_codex_app_compatibility_plan", "label": "Codex App Compatibility Implementation Plan", "file_type": "document", "source_file": "docs/superpowers/plans/2026-03-23-codex-app-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Make using-git-worktrees, finishing-a-development-branch, and related skills work in the Codex App's sandboxed worktree environment without breaking existing behavior (PRI-823)"}, {"id": "docs_superpowers_plans_2026_03_23_codex_app_compatibility_git_dir_git_common_dir_detection", "label": "git-dir vs git-common-dir environment detection", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-03-23-codex-app-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Read-only check distinguishing a linked worktree (GIT_DIR != GIT_COMMON) from a normal repo, so skills skip redundant worktree creation and detect detached HEAD"}, {"id": "docs_superpowers_plans_2026_03_23_codex_app_compatibility_step_zero_workspace_detection", "label": "using-git-worktrees Step 0: isolated-workspace detection", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-03-23-codex-app-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Skip worktree creation when already inside a linked worktree (created by the Codex App, Claude Code's Agent tool, a previous skill run, or the user); report state and stop"}, {"id": "docs_superpowers_plans_2026_03_23_codex_app_compatibility_sandbox_fallback", "label": "Sandbox fallback for worktree creation permission errors", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-03-23-codex-app-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "git worktree add -b can fail with permission errors in a late-detected restricted environment; fall back to running setup and baseline tests in the current directory instead of failing"}, {"id": "docs_superpowers_plans_2026_03_23_codex_app_compatibility_step_1_5_handoff_payload", "label": "finishing-a-development-branch Step 1.5: detached-HEAD handoff payload", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-03-23-codex-app-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "On detached HEAD in an externally managed worktree the agent cannot create branches, push, or open PRs, so it commits all work and emits a handoff payload (commit SHA, data-loss warning, suggested branch name and commit message) instead of the 4-option menu"}, {"id": "docs_superpowers_plans_2026_03_23_codex_app_compatibility_cleanup_guard", "label": "finishing-a-development-branch Step 5 cleanup guard", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-03-23-codex-app-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The host environment owns externally managed workspaces; re-detecting at cleanup time and skipping removal prevents deleting work the host still tracks"}, {"id": "docs_superpowers_plans_2026_03_23_codex_app_compatibility_skill_using_git_worktrees", "label": "using-git-worktrees skill", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-03-23-codex-app-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Worktree creation + isolation skill; receives Step 0 detection, sandbox fallback, and updated Integration descriptions"}, {"id": "docs_superpowers_plans_2026_03_23_codex_app_compatibility_skill_finishing_a_development_branch", "label": "finishing-a-development-branch skill", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-03-23-codex-app-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Branch finishing workflow skill; receives Step 1.5 detection and the Step 5 cleanup guard"}, {"id": "docs_superpowers_plans_2026_03_23_codex_app_compatibility_skill_subagent_driven_development", "label": "subagent-driven-development skill", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-03-23-codex-app-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plan execution with subagents; its Integration description is updated to say using-git-worktrees ensures (not always creates) an isolated workspace"}, {"id": "docs_superpowers_plans_2026_03_23_codex_app_compatibility_skill_executing_plans", "label": "executing-plans skill", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-03-23-codex-app-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plan execution inline; its Integration description is updated to say using-git-worktrees ensures (not always creates) an isolated workspace"}, {"id": "docs_superpowers_plans_2026_03_23_codex_app_compatibility_codex_tools_reference", "label": "codex-tools.md Codex platform reference", "file_type": "concept", "source_file": "docs/superpowers/plans/2026-03-23-codex-app-compatibility.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Codex platform reference doc; receives Environment Detection and Codex App Finishing sections documenting the detection pattern and the App's native Create-branch / Hand-off-to-local controls"}, {"id": "docs_superpowers_plans_2026_03_23_codex_app_compatibility_codex_app_sandboxed_worktree", "label": "C