{"nodes": [{"id": "docs_superpowers_specs_2026_01_22_document_review_system_design", "label": "Document Review System Design Spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-01-22-document-review-system-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_01_22_document_review_system_design_spec", "label": "Document Review System Design Spec", "file_type": "document", "source_file": "docs/superpowers/specs/2026-01-22-document-review-system-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "docs_superpowers_specs_2026_01_22_document_review_system_design_spec_document_reviewer", "label": "Spec Document Reviewer Stage", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-01-22-document-review-system-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verifies after brainstorming and before writing-plans that the spec is complete, consistent, and ready for planning; checks completeness, coverage, consistency, clarity, and YAGNI, dispatching via the Task tool with subagent_type general-purpose."}, {"id": "docs_superpowers_specs_2026_01_22_document_review_system_design_plan_document_reviewer", "label": "Plan Document Reviewer Stage", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-01-22-document-review-system-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Verifies after writing-plans and before implementation that the plan is complete, matches the spec (reviewer receives both plan and spec path for requirements comparison), and has proper atomic task decomposition with checkbox syntax."}, {"id": "docs_superpowers_specs_2026_01_22_document_review_system_design_iterative_review_loop", "label": "Iterative Review Loop Pattern", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-01-22-document-review-system-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Issues found -> agent fixes -> re-review until approved, mirroring implementation reviews; no hard iteration limit, but the controller surfaces loops exceeding 5 iterations and persistent disagreement after 3 iterations on the same issue to the human, and reviewers remain advisory rather than blocking."}, {"id": "docs_superpowers_specs_2026_01_22_document_review_system_design_chunk_review", "label": "Chunk-by-Chunk Plan Review with Spec Alignment", "file_type": "concept", "source_file": "docs/superpowers/specs/2026-01-22-document-review-system-design.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plans are split into chunks delimited by '## Chunk N: <name>' headings (each under 1000 lines, self-contained); each chunk is reviewed independently against the spec before proceeding to the next, so review verdicts stay scoped and actionable."}], "edges": [{"source": "docs_superpowers_specs_2026_01_22_document_review_system_design_spec", "target": "docs_superpowers_specs_2026_01_22_document_review_system_design_spec_document_reviewer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-01-22-document-review-system-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superpowers_specs_2026_01_22_document_review_system_design_spec", "target": "docs_superpowers_specs_2026_01_22_document_review_system_design_plan_document_reviewer", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "docs/superpowers/specs/2026-01-22-document-review-system-design.md", "source_location": null, "weight": 1.0}, {"source": "docs_superp