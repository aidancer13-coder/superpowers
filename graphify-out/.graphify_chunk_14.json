{
  "nodes": [
    {"id": "docs_superpowers_plans_2026_04_06_worktree_rototill", "label": "Worktree Rototill Implementation Plan", "file_type": "document", "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\plans\\2026-04-06-worktree-rototill.md", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Plan to make superpowers defer to native harness worktree systems when available, fall back to manual git worktrees when not, and fix three known finishing bugs (PRI-974)"},
    {"id": "docs_superpowers_plans_2026_04_06_worktree_rototill_native_tool_preference", "label": "Step 1a Native Worktree Tool Preference", "file_type": "concept", "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\plans\\2026-04-06-worktree-rototill.md", "source_location": "Task 1, Step 3", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Load-bearing assumption of the design: agents prefer native worktree/workspace-isolation tools (e.g. EnterWorktree) over git worktree add; native tools handle directory placement, branch creation, and cleanup automatically"},
    {"id": "docs_superpowers_plans_2026_04_06_worktree_rototill_git_worktree_fallback", "label": "Step 1b Git Worktree Fallback", "file_type": "concept", "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\plans\\2026-04-06-worktree-rototill.md", "source_location": "Task 2, Step 1 (new SKILL.md)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Manual git worktree creation used only when no native tool is available, with directory priority (instructions > existing project-local dirs > default .worktrees/) and mandatory git check-ignore verification to prevent committing worktree contents"},
    {"id": "docs_superpowers_plans_2026_04_06_worktree_rototill_isolation_detection", "label": "Step 0 Existing Isolation Detection (GIT_DIR != GIT_COMMON)", "file_type": "concept", "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\plans\\2026-04-06-worktree-rototill.md", "source_location": "Task 2, Step 1 (new SKILL.md)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Detect before creating anything: if GIT_DIR != GIT_COMMON and not a submodule, already in a linked worktree, so skip creation and never create a nested worktree; includes opt-in consent prompt (#991) before creating a worktree in a normal checkout"},
    {"id": "docs_superpowers_plans_2026_04_06_worktree_rototill_submodule_guard", "label": "Submodule Guard for Worktree Detection", "file_type": "concept", "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\plans\\2026-04-06-worktree-rototill.md", "source_location": "Task 2, Step 1 (new SKILL.md)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "GIT_DIR != GIT_COMMON is also true inside git submodules, so git rev-parse --show-superproject-working-tree must be checked before concluding already in a worktree"},
    {"id": "docs_superpowers_plans_2026_04_06_worktree_rototill_hooks_symlink", "label": "Hooks Symlink After Manual Worktree Creation", "file_type": "concept", "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\plans\\2026-04-06-worktree-rototill.md", "source_location": "Task 2, Step 1 (new SKILL.md)", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Git worktrees do not inherit the parent repo's hooks directory; symlink .git/hooks from the main repo so pre-commit checks and linters do not silently stop"},
    {"id": "docs_superpowers_plans_2026_04_06_worktree_rototill_provenance_based_cleanup", "label": "Provenance-Based Worktree Cleanup", "file_type": "concept", "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\plans\\2026-04-06-worktree-rototill.md", "source_location": "Task 3, Step 1 (new SKILL.md), Step 6", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Only clean up worktrees under .worktrees/ or worktrees/ (created by superpowers); harness-owned workspaces are left in place to avoid phantom state; merge first, verify, remove worktree from main repo root, then delete branch, with git worktree prune for self-healing"},
    {"id": "docs_superpowers_plans_2026_04_06_worktree_rototill_three_finishing_bugs", "label": "Three Known Finishing Bugs (#940, #999, #238)", "file_type": "concept", "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\plans\\2026-04-06-worktree-rototill.md", "source_location": "Task 3, Step 3 commit message", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Bug #940: Option 2 (create PR) no longer cleans up the worktree the user needs for PR iteration; Bug #999: order merge -> verify tests -> remove worktree -> delete branch; Bug #238: cd to main repo root before git worktree remove so it does not fail silently"},
    {"id": "docs_superpowers_plans_2026_04_06_worktree_rototill_red_green_gate_test", "label": "Task 1 GATE: RED/GREEN Validation of Native Tool Preference", "file_type": "concept", "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\plans\\2026-04-06-worktree-rototill.md", "source_location": "Task 1", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Gate task run before touching any skill files: RED confirms agent uses git worktree add with current skill, GREEN confirms updated Step 1a makes agent use EnterWorktree, PRESSURE confirms it holds under time pressure; stop after 2 failed REFACTOR iterations"},
    {"id": "docs_superpowers_plans_2026_04_06_worktree_rototill_rewritten_using_git_worktrees_skill", "label": "Rewritten using-git-worktrees SKILL.md (Task 2)", "file_type": "document", "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\plans\\2026-04-06-worktree-rototill.md", "source_location": "Task 2", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Full rewrite (219 lines to ~210) implementing detect-and-defer: Step 0 detection, Step 1a native preference, Step 1b git fallback with directory policy, Step 3 project setup, Step 4 clean baseline verification"},
