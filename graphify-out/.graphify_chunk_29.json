  "nodes": [
    {
      "id": "docs_superpowers_specs_2026_06_11_visual_companion_final_hardening_fixup_design",
      "label": "Visual Companion Final Hardening Fixup Design",
      "file_type": "document",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-06-11-visual-companion-final-hardening-fixup-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Fixup on top of the existing auth hardening design so PR #1720 (brainstorming-companion) is ready for Jesse review with clean security behavior, deterministic tests, and a PR diff containing only the companion work; explicitly not a redesign of the companion."
    },
    {
      "id": "docs_superpowers_specs_2026_06_11_visual_companion_final_hardening_fixup_design_rebase_onto_dev",
      "label": "Rebase brainstorming-companion onto current dev",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-06-11-visual-companion-final-hardening-fixup-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The branch is conflicted because it contains an older evals submodule bump handled separately; rebasing onto origin/dev and taking dev for the evals conflict keeps evals out of the PR diff while allowing external eval evidence (commit, scenario, command, artifact, RED/GREEN outcome) to be cited in the PR body."
    },
    {
      "id": "docs_superpowers_specs_2026_06_11_visual_companion_final_hardening_fixup_design_root_screen_containment",
      "label": "Root screen route containment (symlink/hardlink escape)",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-06-11-visual-companion-final-hardening-fixup-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The root GET / screen-selection path could still serve symlinks or hardlinks under content/ pointing outside the content directory; getNewestScreen() must apply the same real-path-inside-CONTENT_DIR guard as /files/* and keep the nlink==1 hardlink rejection."
    },
    {
      "id": "docs_superpowers_specs_2026_06_11_visual_companion_final_hardening_fixup_design_fallback_token_isolation",
      "label": "Fallback token isolation on port fallback",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-06-11-visual-companion-final-hardening-fixup-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "When the preferred port is occupied, fallback servers reusing a persisted .last-token could create two live same-project servers sharing one bearer key; on fallback the loaded token is discarded and a fresh unpersisted token generated, and an explicit BRAINSTORM_TOKEN env override fails closed because the occupied server may use the same explicit token."
    },
    {
      "id": "docs_superpowers_specs_2026_06_11_visual_companion_final_hardening_fixup_design_stop_server_ownership_proof",
      "label": "Stop-server process ownership proof (instance id argv)",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-06-11-visual-companion-final-hardening-fixup-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "stop-server.sh could signal an unrelated node server.cjs when strong ownership proof is unavailable; a per-start --brainstorm-server-id=<id> argv token (stored in state/server-instance-id, owner-only) is matched as a full argv token (/proc/<pid>/cmdline preferred, wide ps fallback), and the stop fails closed (not_running/stale_pid outcomes) because it is intentionally better to leave a stale process running than kill an unrelated one."
    },
    {
      "id": "docs_superpowers_specs_2026_06_11_visual_companion_final_hardening_fixup_design_test_hardening",
      "label": "Deterministic test hardening (macOS and Windows Git Bash)",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-06-11-visual-companion-final-hardening-fixup-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Some tests could pass against the wrong fallback process, leak background processes on failure, or assume symlink support on Windows-like hosts; fixed-port suites must fail fast on fallback or drive clients from the reported port, stop-server.test.sh gets a top-level cleanup trap, symlink assertions probe capability first, and impostor-process tests assert the impostor survives."
    },
    {
      "id": "docs_superpowers_specs_2026_06_11_visual_companion_final_hardening_fixup_design_docs_pr_consistency",
      "label": "Docs and PR body consistency before review",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-06-11-visual-companion-final-hardening-fixup-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Reviewer-visible docs and PR metadata must match what the PR ships: issue catalog dispositions, auto-open docs vs --open behavior, 4-hour default idle timeout everywhere, PR template compliance after rebase, and concrete macOS/Windows/browser/external-eval evidence in the PR body."
    }
  ],
