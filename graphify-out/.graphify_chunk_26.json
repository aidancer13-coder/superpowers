    {
      "id": "docs_superpowers_specs_2026_05_05_platform_neutral_prose_design_phase_a",
      "label": "Phase A: neutralize generic Claude prose in skills and README",
      "file_type": "concept",
      "rationale": "Avoids the mistake of openai/plugins#217's wholesale rewrite (which altered historical attribution, model names, and install instructions); only genuinely incidental platform-centric prose is removed, in phase-sliced atomic commits with carve-outs for model names, filenames/URLs, and the Claude Code runtime name.",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-05-05-platform-neutral-prose-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "docs_superpowers_specs_2026_05_05_platform_neutral_prose_design_cso_sdo_rename",
      "label": "Coined-term rename: Claude Search Optimization (CSO) → Skill Discovery Optimization (SDO)",
      "file_type": "concept",
      "rationale": "The coined term embedded a platform name in a concept that applies to any agent runtime; renaming the heading, acronym, and in-file cross-references in skills/writing-skills/SKILL.md is done first as its own mechanical, easily revertable commit.",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-05-05-platform-neutral-prose-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "docs_superpowers_specs_2026_05_05_platform_neutral_prose_design_replacement_style",
      "label": "Replacement style: second/third-person agent phrasing",
      "file_type": "concept",
      "rationale": "A mix of 'your agent' (addressing the skill author) and 'the agent/agents' (generic system behavior) reads naturally in English; consistency is not forced at the cost of awkward phrasing, and pluralization is preferred when natural.",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-05-05-platform-neutral-prose-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
