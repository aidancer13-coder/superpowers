    {
      "id": "docs_superpowers_specs_2026_05_06_lift_drill_into_evals_design_evals_harness",
      "label": "evals/ as the canonical LLM-behavior eval harness",
      "file_type": "concept",
      "rationale": "Drill (obra/drill) was already the de facto eval harness — PRI-1397 had lifted ~22 superpowers bash tests into drill scenarios and a recent superpowers commit removed a redundant bash test 'replaced by drill behavioral coverage'; this spec completes the migration by making evals/ the canonical home, with a meaningful documented split between tests/ (plugin infrastructure) and evals/ (LLM actor+verifier behavior).",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-05-06-lift-drill-into-evals-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "docs_superpowers_specs_2026_05_06_lift_drill_into_evals_design_deletion_gate",
      "label": "Per-bash-test deletion gate: verifiable drill coverage of every assertion",
      "file_type": "concept",
      "rationale": "A bash test is deleted only if a drill scenario verifiably covers every assertion it makes (per-assertion table produced by an independent subagent); if any check is unmatched the default is to keep the bash test or extend the scenario, so no coverage is silently lost.",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-05-06-lift-drill-into-evals-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "docs_superpowers_specs_2026_05_06_lift_drill_into_evals_design_verification_protocol",
      "label": "Subagent-gated verification protocol for the migration",
      "file_type": "concept",
      "rationale": "Every change category (deletions, verbatim copy with per-file SHA-256 checksums, path-default change, stale-reference scrub, final adversarial review) is cross-checked by an independent subagent before commit, and each subagent's output is summarized in the commit message so the trail is auditable.",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-05-06-lift-drill-into-evals-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "docs_superpowers_specs_2026_05_06_lift_drill_into_evals_design_drill",
      "label": "Drill: Python skill-compliance benchmark (tmux sessions, LLM actor + verifier)",
      "file_type": "concept",
      "rationale": "Named external tool being migrated: drives real tmux sessions, runs an LLM actor as simulated user, an LLM verifier on the transcript, reports pass/fail per scenario; supports Claude Code, Codex, Gemini CLI, OpenCode, and Copilot CLI. The Python package keeps its drill name inside evals/ to keep the diff small.",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-05-06-lift-drill-into-evals-design.md",
      "source_location": null,
      "source_url": null,
