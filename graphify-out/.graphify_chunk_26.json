    {
      "id": "docs_superpowers_specs_2026_05_05_platform_neutral_readme_design_alphabetical_ordering",
      "label": "Strict alphabetical ordering of README platform listings",
      "file_type": "concept",
      "rationale": "After Phases A and B neutralized prose and config references, the remaining platform-leaning signal was layout: Claude Code listed first and other listings not alphabetical. Reordering both the quickstart list and install sub-sections to strict alphabetical order removes that signal with zero prose changes; Claude Code stays first only by alphabetical chance.",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-05-05-platform-neutral-readme-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "docs_superpowers_specs_2026_05_06_lift_drill_into_evals_design",
      "label": "Lift drill into superpowers as evals/ — design spec",
      "file_type": "document",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-05-06-lift-drill-into-evals-design.md",
