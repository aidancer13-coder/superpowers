      "id": "docs_windows_polyglot_hooks_run_hook_cmd",
      "label": "run-hook.cmd polyglot dispatcher",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\windows\\polyglot-hooks.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Single generic dispatcher that is a polyglot script: Windows parses the first block as batch, Unix treats it as a no-op heredoc and continues, so one file works on Windows/macOS/Linux."
    },
    {
      "id": "docs_windows_polyglot_hooks_extensionless_scripts",
      "label": "Extensionless hook scripts",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\windows\\polyglot-hooks.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Hook scripts are extensionless (session-start, not session-start.sh) so Claude Code's Windows .sh auto-prepend does not inject 'bash' and break the dispatcher."
    },
