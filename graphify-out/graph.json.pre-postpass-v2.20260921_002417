   "id": "docs_superpowers_plans_2026_06_09_visual_companion_issues_a1_per_session_secret_key",
   "label": "A1 — per-session secret key on /, /files/*, and WS (chosen approach; supersedes Host allowlist)",
   "author": null,
   "captured_at": null,
   "community": 1,
   "community_name": "Visual Brainstorming Companion",
   "contributor": null,
   "file_type": "concept",
   "norm_label": "a1 — per-session secret key on /, /files/*, and ws (chosen approach; supersedes host allowlist)",
   "rationale": "A per-session secret key is the only mechanism that authenticates a client uniformly across loopback, SSH tunnel, and direct-remote, and also defeats DNS rebinding; a Host allowlist only defends the loopback browser confused-deputy and is theater for remote exposure, where a direct client just sends the expected Host.",
   "source_file": "docs/superpowers/plans/2026-06-09-visual-companion-issues.md",
   "source_location": null,
   "source_url": null,
