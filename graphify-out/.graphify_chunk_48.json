    {
      "id": "skills_writing_skills_persuasion_principles_authority",
      "label": "Authority (Persuasion Principle)",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\skills\\writing-skills\\persuasion-principles.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Imperative, non-negotiable language (\"YOU MUST\", \"No exceptions\") eliminates decision fatigue and rationalization, so discipline-enforcing and safety-critical practices get followed even under pressure."
    },
    {
      "id": "skills_writing_skills_persuasion_principles_commitment",
      "label": "Commitment (Persuasion Principle)",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\skills\\writing-skills\\persuasion-principles.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Requiring announcements and explicit choices binds the agent to prior statements, ensuring skills are actually followed and creating accountability in multi-step processes."
    },
    {
      "id": "skills_writing_skills_persuasion_principles_scarcity",
      "label": "Scarcity (Persuasion Principle)",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\skills\\writing-skills\\persuasion-principles.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Time-bound requirements and sequential dependencies (\"Before proceeding\", \"Immediately after X\") create urgency that prevents the 'I'll do it later' postponement of verification steps."
    },
    {
      "id": "skills_writing_skills_persuasion_principles_social_proof",
      "label": "Social Proof (Persuasion Principle)",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\skills\\writing-skills\\persuasion-principles.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Universal patterns (\"Every time\") and failure-mode framing (\"X without Y = failure\") establish norms and warn about common failures, reinforcing standards."
    },
    {
      "id": "skills_writing_skills_persuasion_principles_unity",
      "label": "Unity (Persuasion Principle)",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\skills\\writing-skills\\persuasion-principles.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Collaborative language and shared goals (\"we're colleagues\", \"we both want quality\") build in-group belonging, suited to collaborative and non-hierarchical workflows."
    },
    {
      "id": "skills_writing_skills_persuasion_principles_reciprocity",
      "label": "Reciprocity (Persuasion Principle)",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\skills\\writing-skills\\persuasion-principles.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Use sparingly - it can feel manipulative and is rarely needed in skills because other principles are more effective."
    },
    {
      "id": "skills_writing_skills_persuasion_principles_liking",
      "label": "Liking (Persuasion Principle)",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\skills\\writing-skills\\persuasion-principles.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Don't use for compliance: it conflicts with an honest feedback culture and creates sycophancy, so it is avoided whenever discipline is being enforced."
    },
    {
      "id": "skills_writing_skills_persuasion_principles_parahuman_model",
      "label": "Parahuman Model of LLM Behavior",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\skills\\writing-skills\\persuasion-principles.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "LLMs respond to the same persuasion principles as humans because they are trained on human text where authority language precedes compliance, commitment sequences are frequently modeled, and social-proof patterns establish norms."
    },
    {
      "id": "skills_writing_skills_persuasion_principles_meincke_2025",
