    {
      "id": "skills_writing_skills_testing_skills_with_subagents_tdd_mapping",
      "label": "TDD Mapping for Skill Testing (RED-GREEN-REFACTOR)",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\skills\\writing-skills\\testing-skills-with-subagents.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Skill creation is just TDD applied to process documentation: run scenarios without the skill (RED - watch it fail), write a skill addressing those specific failures (GREEN), then close loopholes (REFACTOR). If you never watched an agent fail without the skill, you don't know if the skill prevents the right failures."
    },
    {
      "id": "skills_writing_skills_testing_skills_with_subagents_pressure_scenarios",
      "label": "Pressure Scenarios for Skill Testing",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\skills\\writing-skills\\testing-skills-with-subagents.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Combine 3+ pressures (time, sunk cost, authority, economic, exhaustion, social, pragmatic) with concrete A/B/C options so the agent WANTS to violate the rule - agents resist a single pressure but break under multiple, and only then do you learn what the skill must prevent."
    },
    {
      "id": "skills_writing_skills_testing_skills_with_subagents_rationalization_table",
      "label": "Rationalization Table",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\skills\\writing-skills\\testing-skills-with-subagents.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Capture every agent excuse verbatim and plug each hole with an explicit negation in the rule plus a table entry and red-flag entry, because generic counters (\"don't cheat\") don't work - each specific rationalization needs a specific counter."
    },
    {
      "id": "skills_writing_skills_examples_claude_md_testing_documentation_variants",
      "label": "CLAUDE.md Skills Documentation Variants (A-D)",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\skills\\writing-skills\\examples\\CLAUDE_MD_TESTING.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Tested to find which CLAUDE.md wording actually makes agents discover and use skills under pressure: NULL baseline, A soft suggestion, B directive, C emphatic (Claude.AI style), D process-oriented - variants escalate from suggestion to non-negotiable imperative."
    },
    {
      "id": "skills_writing_skills_examples_claude_md_testing_test_scenarios",
      "label": "CLAUDE.md Test Scenarios (4 pressure scenarios)",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\skills\\writing-skills\\examples\\CLAUDE_MD_TESTING.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Four scenarios - time pressure + confidence, sunk cost + works already, authority + speed bias, familiarity + efficiency - each pit the 'check the skills library first' behavior against a strong incentive to skip it."
    }
  ],
