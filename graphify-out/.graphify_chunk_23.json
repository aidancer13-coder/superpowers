    {
      "id": "docs_superpowers_plans_2026_08_06_hermes_version_bump_wiring_manifest_format_dispatch",
      "label": "Manifest Format Dispatch (jq for JSON, yq for YAML)",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\plans\\2026-08-06-hermes-version-bump-wiring.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Extension-based dispatcher routes manifest reads/writes by file extension: JSON continues through jq while .yaml uses Mike Farah yq v4, with field names and values passed as environment data rather than interpolated into expressions."
    },
    {
      "id": "docs_superpowers_plans_2026_08_06_hermes_version_bump_wiring_preflight_manifests",
      "label": "Bump-Only Manifest Preflight",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\plans\\2026-08-06-hermes-version-bump-wiring.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Reads every present declared manifest through the dispatcher before the first write of the mutating bump loop, so a deterministic YAML format or field failure cannot leave earlier JSON manifests partially updated; no rollback or transactional writes are added."
    },
    {
      "id": "docs_superpowers_plans_2026_08_06_hermes_version_bump_wiring_hermes_yaml_manifest",
      "label": "Hermes YAML Manifest Registration (.hermes-plugin/plugin.yaml)",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\plans\\2026-08-06-hermes-version-bump-wiring.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Registers the top-level version field of .hermes-plugin/plugin.yaml in .version-bump.json so the Hermes YAML manifest version stays synchronized with every other declared release manifest."
    },
    {
