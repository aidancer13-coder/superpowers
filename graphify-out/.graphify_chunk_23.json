    {
      "id": "docs_superpowers_specs_2026_01_22_document_review_system_design_spec_document_reviewer",
      "label": "Spec Document Reviewer Stage",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-01-22-document-review-system-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Verifies after brainstorming and before writing-plans that the spec is complete, consistent, and ready for planning; checks completeness, coverage, consistency, clarity, and YAGNI, dispatching via the Task tool with subagent_type general-purpose."
    },
    {
      "id": "docs_superpowers_specs_2026_01_22_document_review_system_design_plan_document_reviewer",
      "label": "Plan Document Reviewer Stage",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-01-22-document-review-system-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Verifies after writing-plans and before implementation that the plan is complete, matches the spec (reviewer receives both plan and spec path for requirements comparison), and has proper atomic task decomposition with checkbox syntax."
    },
    {
      "id": "docs_superpowers_specs_2026_01_22_document_review_system_design_iterative_review_loop",
      "label": "Iterative Review Loop Pattern",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-01-22-document-review-system-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Issues found -> agent fixes -> re-review until approved, mirroring implementation reviews; no hard iteration limit, but the controller surfaces loops exceeding 5 iterations and persistent disagreement after 3 iterations on the same issue to the human, and reviewers remain advisory rather than blocking."
    },
    {
      "id": "docs_superpowers_specs_2026_01_22_document_review_system_design_chunk_review",
      "label": "Chunk-by-Chunk Plan Review with Spec Alignment",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-01-22-document-review-system-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Plans are split into chunks delimited by '## Chunk N: <name>' headings (each under 1000 lines, self-contained); each chunk is reviewed independently against the spec before proceeding to the next, so review verdicts stay scoped and actionable."
    },
    {
      "id": "docs_superpowers_specs_2026_02_19_visual_brainstorming_refactor_design_spec",
      "label": "Visual Brainstorming Refactor Design Spec (Browser Displays, Terminal Commands)",
      "file_type": "document",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-02-19-visual-brainstorming-refactor-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "docs_superpowers_specs_2026_02_19_visual_brainstorming_refactor_design_events_file",
      "label": ".events Per-Screen Interaction Event Stream",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-02-19-visual-brainstorming-refactor-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Server appends user interaction events (JSONL, one object per line) to $SCREEN_DIR/.events, giving Claude the user's full exploration path (clicked A, then B, settled on C) rather than just the final selection; file is cleared when a new HTML screen is detected and its absence means terminal-only feedback."
    },
    {
      "id": "docs_superpowers_specs_2026_02_19_visual_brainstorming_refactor_design_terminal_channel",
      "label": "Browser as Display, Terminal as Conversation Channel",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-02-19-visual-brainstorming-refactor-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Claude Code's execution model is turn-based, so it cannot listen on two channels within one turn; the old blocking TaskOutput(wait-for-feedback.sh) pattern simulated event-driven behavior the platform doesn't support and seized the TUI, so the browser becomes an interactive display while the terminal is the always-unblocked conversation channel."
    },
    {
      "id": "docs_superpowers_specs_2026_02_19_visual_brainstorming_refactor_design_non_blocking_loop",
      "label": "Non-Blocking Brainstorming Loop (Write HTML, End Turn, Read .events)",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-02-19-visual-brainstorming-refactor-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Loop is: Claude writes HTML to the session directory, server pushes a WebSocket reload via chokidar, Claude ends its turn, user clicks in the browser and types feedback in the terminal, then Claude reads .events and merges it with terminal text on the next turn; no background tasks, no TaskOutput blocking, no polling scripts."
    },
    {
      "id": "docs_superpowers_specs_2026_02_19_visual_brainstorming_refactor_design_wait_for_feedback_deletion",
      "label": "Deletion of wait-for-feedback.sh",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-02-19-visual-brainstorming-refactor-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "wait-for-feedback.sh existed only to bridge server-stdout events to Claude; the .events file replaces it because the server writes user interaction events directly and Claude reads them with whatever file-reading mechanism the platform provides, keeping the server code platform-agnostic."
    }
  ],
