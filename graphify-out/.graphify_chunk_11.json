    {
      "id": "docs_superpowers_plans_2026_01_22_document_review_system_spec_review_loop",
      "label": "Spec Review Loop (brainstorming skill)",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\plans\\2026-01-22-document-review-system.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Added to the brainstorming skill after the spec is written; dispatch a reviewer, fix issues and re-dispatch until approved. Same agent that wrote the spec fixes it to preserve context, loop is capped at 5 iterations then escalated to a human, and reviewers are advisory so disagreements can be explained."
    },
    {
      "id": "docs_superpowers_plans_2026_01_22_document_review_system_plan_review_loop",
      "label": "Plan Review Loop (writing-plans skill)",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\plans\\2026-01-22-document-review-system.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Chunk-by-chunk review added to the writing-plans skill before execution handoff; each chunk is dispatched to a plan reviewer to catch TODOs, scope creep, weak task decomposition, and missing verification steps. Chunks are delimited by '## Chunk N' headings, kept under 1000 lines, and logically self-contained."
    },
    {
      "id": "docs_superpowers_plans_2026_01_22_document_review_system_spec_document_reviewer_prompt",
