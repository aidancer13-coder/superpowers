{
  "nodes": [
    {
      "id": "docs_superpowers_specs_2026_08_27_diagnosing_superpowers_design_spec",
      "label": "Diagnosing Superpowers Sessions — Design Spec",
      "file_type": "document",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-08-27-diagnosing-superpowers-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": "2026-08-27",
      "author": null,
      "contributor": null
    },
    {
      "id": "docs_superpowers_specs_2026_08_27_diagnosing_superpowers_design_skill",
      "label": "diagnosing-superpowers skill",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-08-27-diagnosing-superpowers-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": "2026-08-27",
      "author": null,
      "contributor": null,
      "rationale": "Pure prose skill for v1 (no shipped scripts) that works with the user to pin down a wrong superpowers session, examines on-disk transcripts, and reports what happened with evidence; it reports, never diagnoses superpowers — that is the remote triager's job."
    },
    {
      "id": "docs_superpowers_specs_2026_08_27_diagnosing_superpowers_design_problem_intake",
      "label": "Problem intake step",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-08-27-diagnosing-superpowers-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": "2026-08-27",
      "author": null,
      "contributor": null,
      "rationale": "Complaints usually arrive vague; intake asks one question at a time until the problem statement names the session, the turn range, and the observable, because the statement scopes everything downstream."
    },
    {
      "id": "docs_superpowers_specs_2026_08_27_diagnosing_superpowers_design_skill_timeline",
      "label": "Skill timeline analysis dimension",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-08-27-diagnosing-superpowers-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": "2026-08-27",
      "author": null,
      "contributor": null,
      "rationale": "Skill triggering is a first-class analysis dimension: what fired when in response to what, and where a skill's trigger description matched the request but nothing fired or fired late."
    },
    {
      "id": "docs_superpowers_specs_2026_08_27_diagnosing_superpowers_design_plan_adherence",
      "label": "Plan adherence analysis dimension",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-08-27-diagnosing-superpowers-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": "2026-08-27",
      "author": null,
      "contributor": null,
      "rationale": "Quality is judged as process evidence against the plan the session agreed to (design, plan, acceptance criteria, spec/plan files); plan drift after compaction and resume points is common, so those are marked."
    },
    {
      "id": "docs_superpowers_specs_2026_08_27_diagnosing_superpowers_design_repeated_work",
      "label": "Repeated work analysis dimension",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-08-27-diagnosing-superpowers-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": "2026-08-27",
      "author": null,
      "contributor": null,
      "rationale": "Detects the same file read or edited many times, the same command re-run, the same subagent task re-dispatched, and decisions re-derived after they were already made."
    },
    {
      "id": "docs_superpowers_specs_2026_08_27_diagnosing_superpowers_design_stumbles",
      "label": "Stumbles analysis dimension",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-08-27-diagnosing-superpowers-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": "2026-08-27",
      "author": null,
      "contributor": null,
      "rationale": "Catches tool errors, failed commands, retries, reverted edits, backtracking, user corrections, permission denials, hook failures, API errors, crashes, and context overflow."
    },
    {
      "id": "docs_superpowers_specs_2026_08_27_diagnosing_superpowers_design_quality_evidence",
      "label": "Quality evidence analysis dimension",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-08-27-diagnosing-superpowers-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": "2026-08-27",
      "author": null,
      "contributor": null,
      "rationale": "Checks whether 'done', 'verified', 'passing' claims are backed by verification output that precedes them, whether commits match claims, and whether review feedback was addressed; it is not a code review of the resulting diff."
    },
    {
      "id": "docs_superpowers_specs_2026_08_27_diagnosing_superpowers_design_request_conflicts",
      "label": "Request conflicts analysis dimension",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-08-27-diagnosing-superpowers-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": "2026-08-27",
      "author": null,
      "contributor": null,
      "rationale": "Only human-typed prompts count as user instructions (hook output, system-reminder blocks, and tool results arrive with the user role), so contradictions are tracked across turns and against instruction files."
    },
    {
      "id": "docs_superpowers_specs_2026_08_27_diagnosing_superpowers_design_cost_and_time",
      "label": "Cost and time analysis dimension",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-08-27-diagnosing-superpowers-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": "2026-08-27",
      "author": null,
      "contributor": null,
      "rationale": "Accounts tokens (input, output, cache) and wall-clock per human turn, per subagent, and per tool; Claude Code carries per-message usage and Codex emits token_count events."
    },
    {
      "id": "docs_superpowers_specs_2026_08_27_diagnosing_superpowers_design_context_safety",
      "label": "Context safety hard rule",
      "file_type": "rationale",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-08-27-diagnosing-superpowers-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": "2026-08-27",
      "author": null,
      "contributor": null,
      "rationale": "Single transcript lines can hold 100k+ tokens (tool results, images, hook payloads), so never cat or grep a transcript for content: get counts and line numbers first, then extract small fields from specific lines."
    },
    {
      "id": "docs_superpowers_specs_2026_08_27_diagnosing_superpowers_design_red_flags",
      "label": "Red Flags rationalization table",
      "file_type": "rationale",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-08-27-diagnosing-superpowers-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": "2026-08-27",
      "author": null,
      "contributor": null,
      "rationale": "Rows are hypotheses from design; the shipped table is built from rationalizations observed in the RED phase baseline runs — rows that never show up are dropped, rows that do are reworded to match what agents actually said."
    },
    {
      "id": "docs_superpowers_specs_2026_08_27_diagnosing_superpowers_design_report_structure",
      "label": "Fixed report section structure",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-08-27-diagnosing-superpowers-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": "2026-08-27",
      "author": null,
      "contributor": null,
      "rationale": "Fixed section order so a remote triager can rely on it; the superpowers-involvement line (not indicated / possible / likely) is the only place the skill states a belief about superpowers, and it stops at involvement — no defect named, no change proposed."
    },
    {
      "id": "docs_superpowers_specs_2026_08_27_diagnosing_superpowers_design_bundle_export",
      "label": "Scrubbed bundle export step",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-08-27-diagnosing-superpowers-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": "2026-08-27",
      "author": null,
      "contributor": null,
      "rationale": "A bundle is the user's own session data packaged for others, and being handed one unprompted feels intrusive, so the skill never builds a bundle unprompted; scrub and an independent scrub-audit repeat until the audit finds nothing, and a user gate approves before the archive is created."
    },
    {
      "id": "docs_superpowers_specs_2026_08_27_diagnosing_superpowers_design_github_issue_filing",
      "label": "GitHub issue filing step",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-08-27-diagnosing-superpowers-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": "2026-08-27",
      "author": null,
      "contributor": null,
      "rationale": "Runs only when the report says superpowers involvement is possible or likely, or the user asks; nothing is posted anywhere without the user approving the exact text, and the template footer is the durable marker because GitHub drops labels from reporters without push access."
    },
    {
      "id": "docs_superpowers_specs_2026_08_27_diagnosing_superpowers_design_similar_sessions",
      "label": "Similar sessions search step",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-08-27-diagnosing-superpowers-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": "2026-08-27",
      "author": null,
      "contributor": null,
      "rationale": "Local machine only — the skill never reaches into other people's sessions or remote stores; discovery is metadata-first (mtime, size, then marker line numbers) to keep context safe."
    },
    {
      "id": "docs_superpowers_specs_2026_08_27_diagnosing_superpowers_design_claude_code_session_format",
      "label": "Claude Code session store reference",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-08-27-diagnosing-superpowers-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": "2026-08-27",
      "author": null,
      "contributor": null,
      "rationale": "Real field-level detail is given only for formats verified against files on disk (Claude Code 2.1.247): store layout, subagent transcripts, per-entry fields, attributionSkill/attributionPlugin, compact_boundary compaction, and hook payloads."
    },
    {
      "id": "docs_superpowers_specs_2026_08_27_diagnosing_superpowers_design_codex_session_format",
      "label": "Codex session store reference",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-08-27-diagnosing-superpowers-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": "2026-08-27",
      "author": null,
      "contributor": null,
      "rationale": "Verified against files on this machine (Codex CLI 0.147.0); Codex has no skill attribution field, so skill use is inferred from function_call reads of SKILL.md paths and multi-agent spawn records."
    },
    {
      "id": "docs_superpowers_specs_2026_08_27_diagnosing_superpowers_design_other_harness_discovery",
      "label": "Other-harness discovery procedure",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-08-27-diagnosing-superpowers-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": "2026-08-27",
      "author": null,
      "contributor": null,
      "rationale": "No invented formats: the running harness is expected to know its own session store, and the skill tells it to use that knowledge and say plainly what it could and could not read."
    },
    {
      "id": "docs_superpowers_specs_2026_08_27_diagnosing_superpowers_design_red_green_testing",
      "label": "RED/GREEN/REFACTOR testing plan",
      "file_type": "rationale",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-08-27-diagnosing-superpowers-design.md",
      "source_location": null,
      "source_url": null,
      "captured_at": "2026-08-27",
      "author": null,
      "contributor": null,
      "rationale": "Per writing-skills, no skill without a failing test first: baseline scenarios run on real transcripts with a known problem but without the skill, behavior and rationalizations are recorded verbatim, and the skill is written to the observed failures."
    }
  ],
