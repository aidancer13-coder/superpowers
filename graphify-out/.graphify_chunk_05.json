    {
      "id": "readme_how_it_works",
      "label": "Superpowers core workflow (spec -> plan -> subagent implementation)",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The agent steps back and asks what you are really trying to do before writing code, so work starts from an approved spec and plan instead of jumping straight into implementation; skills trigger automatically so nothing special is needed."
    },
    {
      "id": "readme_subagent_driven_development",
      "label": "subagent-driven-development",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Dispatches a fresh subagent per task with a review after each (most thorough option) so the agent can work autonomously for hours without deviating from the plan."
    },
    {
      "id": "readme_test_driven_development",
      "label": "test-driven-development (RED-GREEN-REFACTOR)",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Enforces true red/green TDD: write a failing test, watch it fail, write minimal code, watch it pass, commit; code written before tests is deleted to keep tests honest."
    },
    {
      "id": "readme_brainstorming",
      "label": "brainstorming skill (Socratic design refinement)",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Activates before writing code and refines rough ideas through questions, exploring alternatives and presenting the design in digestible sections for validation, saving a design document."
    },
    {
      "id": "readme_writing_plans",
      "label": "writing-plans skill",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Breaks work into bite-sized 2-5 minute tasks with exact file paths, complete code and verification steps so the plan is followable by an enthusiastic junior engineer with no project context."
    },
    {
      "id": "readme_executing_plans",
      "label": "executing-plans skill",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Inline plan execution alternative: one context, one final review of the whole branch at the end; the cheapest execution mode versus per-task subagents."
    },
    {
      "id": "readme_using_git_worktrees",
      "label": "using-git-worktrees skill",
      "file_type": "concept",
      "source_file": "C:\\Users\\Comp\\superpowers\\README.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Creates an isolated workspace on a new branch after design approval and verifies a clean test baseline so implementation does not disturb the main checkout."
    },
    {
      "id": "readme_requesting_code_review",
      "label": "requesting-code-review skill",
      "file_type": "concept",
