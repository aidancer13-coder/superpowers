    {
      "id": "docs_superpowers_specs_2026_06_09_sdd_task_scoped_review_dispatch_design_test_rerun_principle",
      "label": "Don't Re-Run Tests on Code That Hasn't Changed",
      "file_type": "rationale",
      "rationale": "The implementer's report already carries test results and TDD RED/GREEN evidence for exactly the code under review, so a reviewer re-running the suite on identical code is pure redundant cost; reviewers verify by reading and run only a focused test when reading raises a specific doubt no existing run answers.",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\specs\\2026-06-09-sdd-task-scoped-review-dispatch-design.md",
      "source_location": null,
      "source_url": null,
