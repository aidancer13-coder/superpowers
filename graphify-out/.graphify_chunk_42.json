    {
      "id": "skills_systematic_debugging_iron_law",
      "label": "Iron Law: No Fixes Without Root Cause Investigation",
      "file_type": "concept",
      "rationale": "WHY: 'ALWAYS find root cause before attempting fixes. Symptom fixes are failure.' The Iron Law forces Phase 1 completion before any fix, so agents don't skip investigation under time pressure or when a quick fix seems obvious.",
      "source_file": "C:\\Users\\Comp\\superpowers\\skills\\systematic-debugging\\SKILL.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null
    },
    {
      "id": "skills_systematic_debugging_architecture_question",
      "label": "Question Architecture After 3+ Failed Fixes",
      "file_type": "concept",
      "rationale": "WHY: 3+ failed fixes signal a wrong architecture, not a failed hypothesis. Stop and question fundamentals with the human partner before attempting a 4th fix, since repeated fixes reveal shared state/coupling rather than isolated bugs.",
      "source_file": "C:\\Users\\Comp\\superpowers\\skills\\systematic-debugging\\SKILL.md",
