      "id": "docs_superpowers_plans_2026_07_15_sdd_fix_loop_redesign_plan",
      "label": "SDD Fix-Loop Redesign Implementation Plan",
      "file_type": "document",
      "source_file": "C:\\Users\\Comp\\superpowers\\docs\\superpowers\\plans\\2026-07-15-sdd-fix-loop-redesign.md",
